7\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0436\u0435 \u0442\u0430\u043C \u0431\u044B\u043B, \u0442\u0430\u043A \u043A\u0430\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043E\u043D \u044D\u0442\u043E \u0432 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u0443, \u0443 \u043D\u0430\u0441 \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0438, \u0447\u0442\u043E \u0433\u043E\u0440\u0430 \u043D\u0430\u0441 \u043F\u0443\u0441\u0442\u0438\u0442. \u0410 \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F, \u043D\u0430 \u0443\u0442\u0440\u043E \u043D\u0430 \u043D\u0430\u0441 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043B\u0430\u0432\u0438\u043D\u043A\u0430, \u0432\u0441\u0435 \u0443\u0434\u0438\u0432\u043B\u044F\u044F\u0441\u044C \u0441\u043D\u0430\u0447\u0430\u043B\u0430, \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u0442\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u043E \u0440\u0430\u0437\u043D\u044B\u043C \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C, \u043F\u043E-\u043C\u043E\u0435\u043C\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u0414\u0435\u043D\u0438\u0441 \u0438 \u0414\u0438\u043C\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u0444\u043E\u0442\u0430\u0442\u044C :)\u003C/p\u003E\r\n\u003Cp\u003E\u0414\u043B\u044F \u0414\u0438\u043C\u044B \u0444\u043E\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0439 \u0432\u0435\u0449\u044C\u044E, \u043E\u043D \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u0438 \u0432 \u0442\u0440\u0443\u0434\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u0445 \u0437\u0430\u0441\u043D\u044F\u0442\u044C \u043A\u0430\u0434\u0440, \u0438 \u043