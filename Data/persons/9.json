043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0435 \u0431\u043E\u0442\u0438\u043D\u043A\u0438. \u0418\u043C\u0435\u043D\u043D\u043E \u0432 \u043D\u0438\u0445 \u044F \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u0414\u0438\u043C\u0443 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043D\u0430 \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u044B\u0445 \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432\u044B\u0445 \u0441\u043F\u0430\u0441\u0430\u0445. \u0415\u0449\u0435 \u0443\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438\u0448\u0435\u043B \u0432 \u043A\u043B\u0443\u0431, \u0430 \u0443\u0436\u0435 \u0432 \u043F\u043B\u0430\u0441\u0442\u0430\u0445)) \u041F\u043E\u0437\u0436\u0435 \u043F\u043E\u043D\u044F\u043B\u0430, \u0447\u0442\u043E \u044D\u0442\u043E \u0414\u0438\u043C\u0438\u043D\u0430 \u0447\u0435\u0440\u0442\u0430 - \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u0439 \u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u0445\u043E\u0434 \u043A\u043E \u0432\u0441\u0435\u043C\u0443, \u0434\u0430 \u0438 \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0443\u0436\u0435 \u0431\u044B\u043B \u0434\u043E \u043A\u043B\u0443\u0431\u0430.\u003Cbr /\u003E\u0412\u043E\u043E\u0431\u0449\u0435, \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0427\u0435\u043B\u043E\u0432\u0435\u043A. \u0412\u0441\u0435, \u0437\u0430 \u0447\u0442\u043E \u0431\u044B \u0414\u0438\u043C\u0430 \u043D\u0435 \u0431\u0440\u0430\u043B\u0441\u044F (\u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430, \u0447\u0442\u043E \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F) \u0434\u043E\u0432\u043E\u0434\u0438\u043B \u0435\u0441\u043B\u0438 \u0438 \u043D\u0435 \u0434\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u0430, \u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u043B\u0430\u043B \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435.\u0026nbsp;\u003C/p\u003E","Category":1,"AttachmentType":5,"Order":34,"CreatedAt":"2012-08-14T12:32:47","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u041C\u0430\u043A\u0443\u043D\u0438\u043D \u0410\u043B\u0435\u043A\u0441\u0435\u0439","Subtitle":"\u041C\u0430\u043A\u0443\u043D\u0438\u043D \u0410\u043B\u0435\u043A\u0441\u0435\u0439","IsActive":true,"Data":"\u003Cp\u003E\u041E\u0431\u0449\u0430\u043B\u0441\u044F \u0441 \u0414\u0438\u043C\u043A\u043E\u0439 \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0437. \u0412 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F \u0441 \u043D\u0438\u043C \u043D\u0430 \u0441\u0431\u043E\u0440\u0430\u0445 \u0432 \u0410\u043B\u0430-\u0410\u0440\u0447\u0435. \u041E\u0447\u0435\u043D\u044C \u043A\u043E\u043C\u043F\u0430\u043D\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0430\u0440\u0435\u043D\u044C. \u0421 \u043D\u0438\u043C \u0438 \u0441 \u0418\u0440\u0438\u043D\u043E\u0439 \u0421\u043A\u043B\u044F\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u043D\u0430 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u0430\u0445 \u0432 \u041A\u0438\u0440\u0435\u0435\u0432\u0441\u043A \u0447\u0435\u0440\u0435\u0437 \u0422\u0438\u043C\u0438\u0440\u044F\u0437\u0435\u0432\u0441\u043A\u0443\u044E \u043B\u0435\u0441\u043D\u0443\u044E \u0434\u0430\u0447\u0443 \u0432 2005 \u0433\u043E\u0434\u0443. \u0418\u0437 \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0444\u0438\u043B\u044C\u043C \u003Ca href=\u0022http://www.youtube.com/watch?feature=player_embedded\u0026amp;v=L7PsBA6nB6w\u0022 target=\u