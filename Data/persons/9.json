E\u0433\u043E \u0410\u043B\u0442\u0430\u044F","IsActive":true,"Data":"http://takt.tusur.ru/our/hike/pox.php?pox=141","Category":2,"AttachmentType":3,"Order":7,"CreatedAt":"2012-06-14T08:32:11","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0422\u0430\u0442\u044C\u044F\u043D\u0430 \u041F\u0430\u0432\u043B\u043E\u0432\u0430 (\u041A\u043E\u043D\u043D\u043E\u0432\u0430)","Subtitle":"\u0422\u0430\u0442\u044C\u044F\u043D\u0430 \u041F\u0430\u0432\u043B\u043E\u0432\u0430 (\u041A\u043E\u043D\u043D\u043E\u0432\u0430)","IsActive":true,"Data":"\u003Cp\u003E\u041F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E \u0432 \u043F\u043E\u0445\u043E\u0434\u0435 \u0441 \u044D\u0442\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u0414\u0438\u043C\u043A\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u043C\u0435\u043B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E. \u0421\u0438\u0434\u0435\u043B\u0438 \u0432 \u043F\u0430\u043B\u0430\u0442\u043A\u0435 \u043F\u0435\u0440\u0435\u0434 \u0411\u0435\u043B\u0443\u0445\u043E\u0439, \u0414\u0438\u043C\u043A\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u0445\u043E\u0434\u0438\u043B \u0434\u043E \u043D\u0430\u0448\u0435\u0433\u043E \u043F\u043E\u0445\u043E\u0434\u0430 \u043D\u0430 \u0411\u0435\u043B\u0443\u0445\u0443 \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430\u043C\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441 \u043D\u0430\u043C\u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F, \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u043D\u0435 \u0445\u0432\u0430\u0441\u0442\u0430\u044F\u0441\u044C, \u0438 \u0442\u043E\u0433\u0434\u0430 \u043C\u044B \u0442\u0430\u043A \u0440\u0430\u0434\u044B \u0431\u044B\u043B\u0438 \u044D\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0438\u0437 \u043D\u0430\u0441 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0436\u0435 \u0442\u0430\u043C \u0431\u044B\u043B, \u0442\u0430\u043A \u043A\u0430\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043E\u043D \u044D\u0442\u043E \u0432 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u0443, \u0443 \u043D\u0430\u0441 \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0438, \u0447\u0442\u043E \u0433\u043E\u0440\u0430 \u043D\u0430\u0441 \u043F\u0443\u0441\u0442\u0438\u0442. \u0410 \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F, \u043D\u0430 \u0443\u0442\u0440\u043E \u043D\u0430 \u043D\u0430\u0441 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043B\u0430\u0432\u0438\u043D\u043A\u0430, \u0432\u0441\u0435 \u0443\u0434\u0438\u0432\u043B\u044F\u044F\u0441\u044C \u0441\u043D\u0430\u0447\u0430\u043B\u0430, \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u0442\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u043E \u0440\u0430\u0437\u043D\u044B\u043C \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C, \u043F\u043E-\u043C\u043E\u0435\u043C\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u0414\u0435\u043D\u0438\u0441 \u0438 \u0414\u0438\u043C\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u0444\u043E\u0442\u0430\u0442\u044C :)\u003C/p\u003E\r\n\u003Cp\u003E\u0414\u043B\u044F \u0414\u0438\u043C\u044B \u0444\u043E\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0439 \u0432\u0435\u0449\u044C\u044E, \u043E\u043D \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u0438 \u0432 \u0442\u0440\u0443\u0434\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u0445 \u0437\u0430\u0441\u043D\u044F\u0442\u044C \u043A\u0430\u0434\u0440, \u0438 \u043D\u0430 \u0431\u0438\u0432\u0443\u0430\u043A\u0430\u0445, \u0434\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u0442\u044F\u0436\u043A\u043E \u0431\u044B\u043B\u043E, \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u043B \u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442. \u0415\u0449\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441\u0440\u0430\u0437\u0443, \u043A\u0430\u043A \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438 \u043A \u043D\u0435\u043C\u0443 \u0432 \u0433\u043E\u0441\u0442\u0438, \u0438 \u043E\u043D \u0444\u043E\u0442\u043E \u0441\u0432\u043E\u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B, \u0441 \u0432\u043E\u0441\u0442\u043E\u0440\u0433\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043F\u0440\u043E \u043C\u0435\u0441\u0442\u0430, \u043A\u0430\u043A \u043E\u043D \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u043B \u0432\u043E\u0434\u043E\u043F\u0430\u0434\u044B \u0438 \u0432\u043E\u0434\u0443 \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0435, \u044D\u0442\u043E \u0431\u044B\u043B\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438, \u0442\u043E\u0433\u0434\u0430 \u0435\u0449\u0451 \u0442\u0430\u043A \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0437 \u043D\u0430\u0441, \u043E\u0442 \u043D\u0435\u0433\u043E \u043C\u044B \u0438 \u0437\u0430\u0440\u0430\u0437\u0438\u043B\u0438\u0441\u044C \u0444\u043E\u0442\u043E\u043F\u0440