{"FirstName":"\u0414\u043C\u0438\u0442\u0440\u0438\u0439","LastName":"\u041F\u0438\u0447\u0443\u0433\u0438\u043D","MaidenName":"","Patronymic":"\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u0438\u0447","Nickname":"","Birthday":"1979-10-30T00:00:00","DeathDay":"2011-08-02T00:00:00","Biography":"\u003Cp\u003E\u041F\u0438\u0447\u0443\u0433\u0438\u043D \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u0438\u0447 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1979\u0433. \u0432 \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A\u0435 (\u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D), \u0438\u0437-\u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u044B \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439 \u0447\u0430\u0441\u0442\u044C \u0434\u0435\u0442\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0432\u0435\u043B \u0432 \u0410\u043B\u0436\u0438\u0440\u0435. \u003Cbr /\u003E\u0412 \u0422\u043E\u043C\u0441\u043A\u0435 \u0443\u0447\u0438\u043B\u0441\u044F \u0432 40-\u0439 \u0448\u043A\u043E\u043B\u0435. \u0412 1996 \u0433\u043E\u0434\u0443, \u043F\u043E\u0441\u043B\u0435 \u0448\u043A\u043E\u043B\u044B, \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0422\u041F\u0423 \u043D\u0430 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u0410\u0412\u0422\u0424, \u043A\u0430\u0444\u0435\u0434\u0440\u0443 \u041E\u0421\u0423. \u041F\u043E\u0441\u043B\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0412\u0423\u0417\u0430 \u0432 2002 \u0433\u043E\u0434\u0443 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0430\u0441\u043F\u0438\u0440\u0430\u043D\u0442\u0443\u0440\u0443. \u0417\u0430\u0449\u0438\u0442\u0438\u043B \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0441\u043A\u0443\u044E \u0434\u0438\u0441\u0441\u0435\u0440\u0442\u0430\u0446\u0438\u044E, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0441\u043E\u0432\u043C\u0435\u0449\u0430\u044F \u0430\u0441\u043F\u0438\u0440\u0430\u043D\u0442\u0443\u0440\u0443 \u0441 \u0440\u0430\u0431\u043E\u0442\u043E\u0439. \u0420\u0430\u0431\u043E\u0442\u0430\u043B web-\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u043E\u043C, \u043A\u0430\u043A \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u0445, \u0442\u0430\u043A \u0438 \u0432 \u0441\u0432\u043E\u0435\u0439, \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u043B \u043F\u0440\u043E\u0435\u043A\u0442\u044B \u0434\u043B\u044F \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0445 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u043E\u0432. \u0421 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u043C \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u043E, \u0438 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0022\u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430\u043C\u0438\u0022 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B, \u043D\u043E \u0438 \u0434\u0440\u0443\u0436\u0438\u043B.\u003Cbr /\u003E\u0412 \u0422\u0410\u041A\u0422 \u043F\u0440\u0438\u0448\u0435\u043B \u0432 2001 \u0433\u043E\u0434\u0443, \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0420\u0422\u0424\u0421\u0423, \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u0445\u043E\u0434\u0438\u043B \u043B\u0435\u0442\u043E\u043C \u043D\u0430 \u0410\u043B\u0442\u0430\u0439 \u0441 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u043E\u0439. \u041F\u043E\u0445\u043E\u0434 \u0431\u044B\u043B \u043F\u043E \u0410\u043A\u043A\u0435\u043C\u0443, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0441 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C \u043D\u0430 \u0411\u0435\u043B\u0443\u0445\u0443. \u041D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0431\u044B\u043B \u043D\u043E\u0432\u0438\u0447\u043E\u043A - \u043F\u043E\u0431\u044B\u0432\u0430\u0432\u0448\u0438\u0439 \u043D\u0430 \u0411\u0435\u043B\u0443\u0445\u0435. \u0412\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0443 \u0414\u0438\u043C\u044B \u0431\u044B\u043B\u0430 \u043E\u0447\u0435\u043D\u044C \u043E\u0431\u0448\u0438\u0440\u043D\u0430\u044F \u043F\u043E\u0445\u043E\u0434\u043E\u0433\u0440\u0430\u0444\u0438\u044F, \u043D\u043E \u0410\u043A\u043A\u0435\u043C, \u0411\u0435\u043B\u0443\u0445\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u043B\u044E\u0431\u0438\u043C\u044B\u043C\u0438 \u043C\u0435\u0441\u0442\u0430\u043C\u0438. \u0421\u044E\u0434\u0430 \u043E\u043D \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u043B \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u043F\u043E\u0434 \u0441\u0432\u043E\u0438\u043C \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C.\u003Cbr /\u003E\u0423\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F \u0441\u043D\u043E\u0443\u0431\u043E\u0440\u0434\u043E\u043C - \u043D\u0430\u0447\u0438\u043D\u0430\u043B \u043A\u0430\u0442\u0430\u0442\u044C\u0441\u044F \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0435, \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u043B \u0428\u0435\u0440\u0435\u0433\u0435\u0448. \u041F\u043E\u0437\u0434\u043D\u0435\u0435 \u0432 \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F\u0445 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434 \u0438 \u0432\u0435\u043B\u043E\u043F\u043E\u0445\u043E\u0434\u044B. \u0418\u0437 \u0445\u043E\u0431\u0431\u0438 \u0435\u0449\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E \u0026ndash; \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0432 \u043F\u043E\u0445\u043E\u0434\u0430\u0445 \u043D\u0430 \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0435 \u043C\u044B\u043B\u044C\u043D\u0438\u0446\u044B, \u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0440\u043E\u0441\u043B\u043E \u0432\u043E \u0447\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0435. \u0418 \u0442\u0435\u0445\u043D\u0438\u043A\u0430 \u0441\u0442\u0430\u043B\u0430 \u0434\u0440\u0443\u0433\u0430\u044F, \u0438 \u0441\u0430\u043C\u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432\u044B\u0448\u043B\u0438 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C. \u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u043B \u043D\u0430 \u0441\u0430\u0439\u0442\u0430\u0445:\u003Cbr /\u003E\u003Ca href=\u0022http://mountain.35photo.ru/\u0022 target=\u0022_blank\u0022\u003Ehttp://mountain.35photo.ru/\u003C/a\u003E\u003C/p\u003E\r\n\u003Cp\u003E\u003Ca href=\u0022http://www.photosight.ru/users/147831/\u0022 target=\u0022_blank\u0022\u003Ehttp://www.photosight.ru/users/147831/\u0026nbsp;\u003C/a\u003E\u003C/p\u003E\r\n\u003Cp\u003E\u0412 2007\u0433 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B \u0432 \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0432 2008-2009\u0433\u0433. \u0436\u0438\u043B \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u0424\u0438\u043D\u043B\u044F\u043D\u0434\u0438\u0438, \u0432 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u0435 2009\u0433. \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0432 \u041F\u0438\u0442\u0435\u0440, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0444\u0438\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.\u003Cbr /\u003E\u0416\u0435\u043D\u0430\u0442, \u0435\u0441\u0442\u044C \u0441\u044B\u043D \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 2009 \u0433\u043E\u0434\u0430 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.\u003Cbr /\u003E\u003Cbr /\u003E\u0415\u0449\u0435 \u0414\u0438\u043C\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043C\u0435\u0447\u0442\u0430\u043B \u043E \u041F\u0430\u043C\u0438\u0440\u0435\u0026hellip;\u003Cbr /\u003E2 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2011 \u0433. \u043F\u043E\u0433\u0438\u0431 \u043F\u0440\u0438 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u043D\u0430 \u043F\u0438\u043A \u041A\u0440\u0443\u043F\u0441\u043A\u043E\u0439, \u0432 \u0433\u043E\u0440\u043D\u043E\u043C \u043F\u043E\u0445\u043E\u0434\u0435 5 \u043A.\u0441. \u043F\u043E \u041F\u0430\u043C\u0438\u0440\u0443.\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E","Active":true,"Attachments":[{"Title":"2002 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 3 \u043A.\u0441 \u041A\u0430\u0442\u0443\u043D\u0441\u043A\u0438\u0439 \u0445\u0440\u0435\u0431\u0435\u0442","Subtitle":"2002\u0433 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 3 \u043A.\u0441 \u041A\u0430\u0442\u0443\u043D\u0441\u043A\u0438\u0439 \u0445\u0440\u0435\u0431\u0435\u0442 \u0413\u043E\u0440\u043D\u043E\u0433\u043E \u0410\u043B\u0442\u0430\u044F","IsActive":true,"Data":"http://takt.tusur.ru/lib/report/2002_III_Tulaev/index.html","Category":2,"AttachmentType":3,"Order":0,"CreatedAt":"2012-06-14T08:11:24","PersonId":0,"Person":null,"Id":0},{"Title":"2003\u0433 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 2 \u043A.\u0441. \u043F\u043E \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u0422\u044F\u043D\u044C-\u