{"Id":5,"CardName":"card17.tpl","FirstName":"\u0415\u043B\u0435\u043D\u0430","LastName":"\u041A\u043E\u043B\u0435\u0441\u043D\u0438\u043A\u043E\u0432\u0430","LastName2":"","Patronymic":"\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u043D\u0430","Nickname":"","Birthday":"1983-01-07T00:00:00","DeathDay":"2006-08-11T00:00:00","Biography":"\u003Cp\u003E\u041A\u043E\u043B\u0435\u0441\u043D\u0438\u043A\u043E\u0432\u0430 \u0415\u043B\u0435\u043D\u0430 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u043D\u0430 \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C 7 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 1983 \u0433\u043E\u0434\u0430, \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0422\u043E\u043C\u0441\u043A\u0435. \u041E\u043A\u043E\u043D\u0447\u0438\u043B\u0430 \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443 \u21164, \u0437\u0430\u0442\u0435\u043C \u0443\u0447\u0438\u043B\u0430\u0441\u044C \u0432 \u041F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u043D\u0430 \u0413\u0413\u0424, \u043D\u0430 \u0433\u0435\u043E\u043B\u043E\u0433\u0430. \u041E\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0026nbsp; \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0432 2005 \u0433\u043E\u0434\u0443, \u0437\u0430\u0442\u0435\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u043E\u043C \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0444\u0438\u0440\u043C\u0435 \u043F\u043E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0438 \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0435\u043D\u0438\u044E \u0441\u0430\u0439\u0442\u043E\u0432, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043D\u0430\u0434 \u0441\u0430\u0439\u0442\u043E\u043C life.tomsk.ru. \u0417\u043B\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u044B\u043C \u043B\u0435\u0442\u043E\u043C 2006-\u0433\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0438\u0441\u043A\u0430\u043C\u0438 \u043D\u043E\u0432\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B, \u043F\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438.\u003Cbr /\u003E\u0411\u0440\u043E\u043D\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0430\u0441\u0442\u043C\u043E\u0439 \u0431\u043E\u043B\u0435\u043B\u0430 \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430, \u043D\u043E \u0435\u0435 \u043C\u0430\u043C\u0430 \u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0430\u0441\u044C \u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u0440\u0435\u0431\u0435\u043D\u043A\u0430. \u0417\u0430\u0434\u0430\u0432\u0438\u0442\u044C \u0431\u043E\u043B\u0435\u0437\u043D\u044C \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043D\u0438 \u0438 \u0437\u0430\u043A\u0430\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439, \u0437\u0430\u0434\u0430\u0432\u0438\u0442\u044C, \u043D\u043E \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C. \u0412\u0026nbsp; \u043A\u043B\u0443\u0431 \u043F\u0440\u0438\u0448\u043B\u0430 \u0432 2003\u0433 \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0420\u0422\u0424\u0421\u0423. \u041B\u0435\u043D\u0430 \u043E\u0447\u0435\u043D\u044C \u0436\u0438\u0437\u043D\u0435\u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043B\u0435\u0433\u043A\u0438\u0439 \u0432 \u043E\u0431\u0449\u0435\u043D\u0438\u0438 c \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0441\u043C\u0435\u0445\u043E\u043C. \u041B\u044E\u0431\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043B\u0435\u0433\u043A\u043E \u043C\u043E\u0433 \u0443\u0437\u043D\u0430\u0442\u044C \u0435\u0435 \u043F\u043E \u0441\u043C\u0435\u0445\u0443,\u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0440\u0430\u0437\u0026nbsp; \u0441\u043B\u044B\u0448\u0430\u043B \u0435\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435.\u003Cbr /\u003E\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0430 \u0026laquo;\u041E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F\u0026raquo; (\u043A\u043E\u043D\u0446\u0435\u0440\u0442 \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0439 \u043F\u0435\u0441\u043D\u0438) \u0438 \u0430\u043A\u0442\u0440\u0438\u0441\u0430 \u0442\u0435\u0430\u0442\u0440\u0430 \u0026laquo;\u041E\u043A\u0441\u044E\u043C\u043E\u0440\u043E\u043D\u0026raquo;. \u0421\u044B\u0433\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u043E\u043B\u0438: \u041D\u0430\u0438\u0432\u043D\u0430\u044F, \u043D\u043E \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0430\u044F \u0026laquo;\u0431\u043B\u043E\u043D\u0434\u0438\u043D\u043A\u0430\u0026raquo; \u041B\u0435\u043D\u0430 \u0432 \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0435 \u003Ca title=\u00222005-\u0410\u0441\u043F\u0430\u0440\u0430\u0433\u0443\u0441\u0022 href=\u0022http://oxymoron.tomsk.ru/all/2005-Asparagus/Video/2005_Asparagus.wmv\u0022 target=\u0022_blank\u0022\u003E\u0026laquo;\u0410\u0441\u043F\u0430\u0440\u0430\u0433\u0443\u0441 \u0438\u043B\u0438 \u0447\u0435\u0433\u043E \u0445\u043E\u0442\u044F\u0442 \u0436\u0435\u043D\u0449\u0438\u043D\u044B\u0026raquo; 2005\u0433\u0026nbsp;\u003C/a\u003E \u0438 \u0434\u0435\u0432\u0443\u0448\u043A\u0430 \u0026ndash; \u0430\u043D\u0433\u0435\u043B \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0410\u043D\u0436\u0435\u043B\u0430 \u0432 \u003Ca title=\u00222006-\u0421\u043F\u043E\u0440\u0438\u043C\u0022 href=\u0022http://oxymoron.tomsk.ru/all/2006-Sporim/Video/2006_Sporim.avi\u0022 target=\u0022_blank\u0022\u003E\u0026laquo;\u0421\u043F\u043E\u0440\u0438\u043C?!\u0026raquo; 2006\u0433\u0026nbsp;\u003C/a\u003E \u003Cbr /\u003E\u0412 \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u043E\u0445\u043E\u0434\u044B \u041B\u0435\u043D\u0430 \u0442\u0430\u043A \u0438 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0430 \u0441\u0445\u043E\u0434\u0438\u0442\u044C, \u0445\u043E\u0442\u044F \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0442\u0435\u043B\u0430. \u0411\u044B\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u041C\u0430\u043B\u043E\u0439 \u0421\u044B\u0435 \u0432 \u0026laquo;\u042F\u0449\u0438\u043A\u0435 \u041F\u0430\u043D\u0434\u043E\u0440\u044B\u0026raquo;, \u0435\u0449\u0451 \u043D\u0430 \u0415\u0440\u0433\u0430\u043A\u0430\u0445 \u0432 2005\u043C. \u0438 \u0432\u043E\u0434\u043D\u044B\u0435 \u043F\u043E\u0445\u043E\u0434\u044B \u043F\u043E \u0410\u043B\u0447\u0435\u0434\u0430\u0442\u0443, \u042F\u0435, \u0417\u043E\u043B\u043E\u0442\u043E\u043C\u0443 \u041A\u0438\u0442\u0430\u0442\u0443.\u003Cbr /\u003E\u041B\u0435\u043D\u044B \u043D\u0435 \u0441\u0442\u0430\u043B\u043E 11 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2006\u0433. \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u0435\u043C \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u044F.\u003C/p\u003E","PhotoBig":"http://inmemoria.tusur.ru/media/20120704103116.jpg","PhotoSmall":"http://inmemoria.tusur.ru/media/20120704103116s.jpg","Active":1,"MediaResources":[{"Id":26,"PersonId":5,"Name":"\u041B\u0435\u043D\u0430-1","ResourceType":"img","Rubric":"gallery","Data":"http://inmemoria.tusur.ru/media/5/20120530113635.jpg","Position":1,"CreateTime":"2012-05-15T04:38:36","Comment":"\u041B\u0435\u043D\u04