;\u0421\u043E\u043B\u043E \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435\u0026raquo;, \u0438 \u044F \u0432\u044B\u0443\u0447\u0438\u043B\u0441\u044F \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u044C \u0432\u0441\u043B\u0435\u043F\u0443\u044E \u043A\u0430\u043A \u0431\u044B \u0437\u0430 \u043D\u0435\u0435, \u0447\u0442\u043E \u043B\u0438\u0026hellip;\u003C/p\u003E\r\n\u003Cp\u003E\u041B\u0435\u043D\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u043B\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0442\u0435\u043B\u0430 \u043B\u0430\u0437\u0430\u0442\u044C \u0026laquo;\u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0026raquo;, \u0430 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u0430 \u0442\u0435\u0445\u043D\u0438\u043A\u0430. \u041B\u0430\u0437\u0430\u043D\u0438\u0435 \u0435\u0439 \u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u043B\u0435\u0433\u043A\u043E. \u0418 \u0441\u043A\u0430\u043B\u043E\u0434\u0440\u043E\u043C \u043D\u0430 \u041A\u0422\u0424 \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430 \u0441\u0442\u0440\u043E\u0438\u0442\u044C, \u043A\u0430\u043A \u043C\u043E\u0433\u043B\u0430. \u0412\u0435\u0437\u0434\u0435 \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0431\u044B\u0442\u044C, \u0432\u0441\u0435 \u0443\u0441\u043F\u0435\u0442\u044C. \u0423\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B\u0430\u0441\u044C \u0437\u0430 \u0432\u0441\u0435 \u0441\u0440\u0430\u0437\u0443, \u043D\u043E \u0432\u0435\u0434\u044C \u0443\u0441\u043F\u0435\u0432\u0430\u043B\u0430 \u0432\u0441\u0435\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u0440\u044C\u0435\u0437. \u0421\u043F\u0435\u0448\u0438\u043B\u0430 \u0436\u0438\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435. \u0410 \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u0435\u043B\u0430 \u043F\u043E\u0434 \u0433\u0438\u0442\u0430\u0440\u0443!!! \u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u0438 \u0437\u0432\u043E\u043D\u043A\u0438\u0439 \u0433\u043E\u043B\u043E\u0441.\u003C/p\u003E\r\n\u003Cp\u003E\u041E\u0447\u0435\u043D\u044C \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0441\u044F \u0442\u0430\u043A\u043E\u0439 \u044D\u043F\u0438\u0437\u043E\u0434: \u0412 \u0415\u0444\u0440\u0435\u043C\u043A\u0438\u043D\u043E, \u0432\u043E\u0437\u043B\u0435 \u0434\u043E\u043C\u0430 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439 \u041C\u0430\u0440\u0438\u043D\u044B \u0410\u043F\u0430\u043D\u0430\u0441\u0435\u043D\u043A\u043E \u0435\u0441\u0442\u044C \u0441\u043A\u0430\u043C\u0435\u0435\u0447\u043A\u0430. \u0412\u0435\u0447\u0435\u0440\u043E\u043C \u041B\u0435\u043D\u0430 \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u043C\u0435\u043D\u044F \u0437\u0430 \u0440\u0443\u043A\u0443 \u0438 \u043F\u043E\u0442\u0430\u0449\u0438\u043B\u0430 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443. \u041D\u0430 \u043C\u043E\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0442\u0438\u043F\u0430 \u0026laquo;\u0427\u0442\u043E? \u041A\u0443\u0434\u0430? \u0417\u0430\u0447\u0435\u043C?\u0026raquo; \u043E\u043D\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u043B\u0430 \u0026ndash; \u0026laquo;\u043F\u043E\u0439\u0434\u0435\u043C, \u043F\u043E\u0439\u0434\u0435\u043C\u0026raquo;. \u041F\u0440\u0438\u0432\u0435\u043B\u0430 \u043C\u0435\u043D\u044F \u043A \u044D\u0442\u043E\u0439 \u0441\u043A\u0430\u043C\u0435\u0435\u0447\u043A\u0435, \u0443\u0441\u0430\u0434\u0438\u043B\u0430 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u0026laquo;\u0413\u043E\u0434 \u043D\u0430\u0437\u0430\u0434 \u044F \u0441\u0438\u0434\u0435\u043B\u0430 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0435 \u0438 \u0437\u0430\u0433\u0430\u0434\u0430\u043B\u0430 \u0436\u0435\u043B\u0430\u043D\u0438\u0435, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C \u043E\u043A\u0430\u0436\u0443\u0441\u044C, \u0441\u043E \u043C\u043D\u043E\u0439 \u0431\u0443\u0434\u0435\u0442 \u043C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041C\u043E\u0435 \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u043B\u043E\u0441\u044C!\u0026raquo; \u042F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u0438 \u043C\u043E\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0026hellip;\u003C/p\u003E\r\n\u003Cp\u003E\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0441\u044F \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0441\u043B\u0443\u0447\u0430\u0439 \u0442\u0430\u043C \u0436\u0435: \u041C\u044B \u043F\u043E\u043B\u0430\u0437\u0430\u043B\u0438 \u043D\u0430 \u0441\u043A\u0430\u043B\u0430\u0445 \u0432 \u0421\u044B\u0435 \u0438 \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043F\u043E\u0439\u0442\u0438 \u043D\u0430\u0437\u0430\u0434, \u0432 \u0415\u0444\u0440\u0435\u043C\u043A\u0438\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0421\u0435\u0440\u0435\u0433\u0430 \u0410\u043F\u0430\u043D\u0430\u0441\u0435\u043D\u043A\u043E \u043A\u0443\u0434\u0430-\u0442\u043E \u0443\u0435\u0445\u0430\u043B \u0438 \u043D\u0435 \u043C\u043E\u0433 \u0437\u0430 \u043D\u0430\u043C\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F \u0441\u0440\u0430\u0437\u0443. \u0418\u0434\u0442\u0438 \u0431\u044B\u043B\u043E \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E, \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432 8, \u0438 \u0432\u0441\u0435 \u0431\u044B\u043B\u043E \u0431\u044B \u0445\u043E\u0440\u043E\u0448\u043E, \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0442\u0443\u0447\u0430, \u043D\u0430\u043F\u043E\u043B\u0437\u0430\u0432\u0448\u0430\u044F \u043D\u0430 \u043D\u0430\u0441 \u0441\u043B\u0435\u0432\u0430. \u041E\u0434\u0435\u0436\u0434\u0430 \u0443 \u043D\u0430\u0441 \u0431\u044B\u043B\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043B\u0435\u0442\u043D\u044F\u044F \u0438 \u043D\u0430\u043C \u0026laquo;\u0441\u0432\u0435\u0442\u0438\u043B\u043E\u0026raquo; \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043F\u043E\u0434 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043B\u0438\u0432\u0435\u043D\u044C. \u042F \u0432\u0441\u0435\u0440\u044C\u0435\u0437 \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0441\u044F \u0437\u0430 \u041B\u0435\u043D\u0443. \u041C\u044B \u0448\u043B\u0438 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043D\u0430\u043C \u043F\u043E\u043F\u0430\u043B\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C. \u042F \u043F\u0440\u043E \u0441\u0435\u0431\u044F \u043E\u0442\u043C\u0435\u0442\u0438\u043B \u0026ndash; \u0026laquo;70\u044B\u0439 \u0440\u0435\u0433\u0438\u043E\u043D \u0026ndash; \u0422\u043E\u043C\u0438\u0447! \u041E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D \u0437\u0434\u0435\u0441\u044C?\u0026raquo;, \u0430 \u041B\u0435\u043D\u0430 \u0432\u0441\u043B\u0443\u0445 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0026ndash; \u0026laquo;\u041E, \u043F\u0430\u0440\u0435\u043D\u044C \u0441 \u043C\u043E\u0435\u0439 \u0448\u043A\u043E\u043B\u044B, \u0438\u0437 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430!\u0026raquo; \u0422\u043E-\u0442\u043E \u043E\u043D \u043D\u0430 \u043D\u0430\u0441 \u043F\u044F\u043B\u0438\u043B\u0441\u044F!!! \u0427\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442 \u0435\u0449\u0435 \u043E\u0434\u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u0430 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0026ndash; 70\u044B\u0439 \u0440\u0435\u0433\u0438\u043E\u043D, \u0432 \u043C\u0430\u0448\u0438\u043D\u0435 \u043F\u043E\u0436\u0438\u043B\u0430\u044F \u043F\u0430\u0440\u0430. \u041B\u0435\u043D\u0430 \u0432 \u0441\u0435\u0440\u0434\u0446\u0430\u0445: \u0026laquo;\u0434\u0430 \u0447\u0442\u043E \u043E\u043D\u0438 \u0432\u0441\u0435 \u043D\u0435 \u0432 \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0435\u0434\u0443\u0442!!!\u0026raquo; \u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0435\u0449\u0435 \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 \u0442\u0440\u0435\u0442\u044C\u044F \u043C\u0430\u0448\u0438\u043D\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u044B \u0434\u0443\u043C\u0430\u043B\u0438? \u0026ndash; 70\u044B\u0439 \u0440\u0435\u0433\u0438\u043E\u043D, \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u0430\u044F \u0026laquo;\u043A\u043E\u043F\u0435\u0439\u043A\u0430\u0026raquo;, \u0437\u0430 \u0440\u0443\u043B\u0435\u043C \u0026ndash; \u043A\u0442\u043E \u0431\u044B \u0432\u044B \u0434\u0443\u043C\u0430\u043B\u0438? \u0026ndash; \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0424\u0438\u043B\u043E\u043D\u043E\u0432 \u0421\u043B\u0430\u0432\u0430. \u0423\u0437\u043D\u0430\u043B, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F, \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u043A\u0430\u043A \u0434\u0435\u043B\u0430, \u0433\u0440\u0443\u0441\u0442\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432 \u0441\u0432\u043E\u0439 \u0431\u0438\u0442\u043A\u043E\u043C \u0437\u0430\u0431\u0438\u0442\u044B\u0439 \u043B\u044E\u0434\u044C\u043C\u0438 \u0441\u0430\u043B\u043E\u043D \u043C\u0430\u0448\u0438\u043D\u044B, \u043D\u0430 \u0442\u0443\u0447\u0443, \u0441\u043A\u0430\u0437\u0430\u043B \u0026laquo;\u0431\u043B\u0438\u043D, \u0438 \u0431\u0435\u043D\u0437\u0438\u043D\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442 \u0434\u043E \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0438\u0026raquo;, \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B \u0438 \u0443\u0435\u0445\u0430\u043B. \u041D\u0430\u0447\u0430\u043B\u0438 \u043F\u0430\u0434\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u0435 \u043A\u0440\u0443\u043F\u043D\u044B\u0435 \u043A\u0430\u043F\u043B\u0438, \u0430 \u044F \u0448\u0435\u043B \u0438 \u0434\u0443\u043C\u0430\u043B \u0026ndash; \u0026laquo;\u043A\u0430\u043A \u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u044D\u0442\u043E, \u0432\u043E\u0442 \u0436\u0435 \u0441\u0432\u043E\u0439, \u043A\u043B\u0443\u0431\u043E\u0432\u0441\u043A\u0438\u0439, \u0430 \u043C\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u043C\u043E\u043A\u043D\u0435\u043C\u0026raquo; \u043A\u0430\u043A \u0441\u0437\u0430\u0434\u0438 \u043F\u0440\u043E\u0441\u0438\u0433\u043D\u0430\u043B\u0438\u043B\u0430 \u043C\u0430\u0448\u0438\u043D\u0430. \u0026laquo;\u0421\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438, \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0435\u043C \u0441 \u0431\u0435\u043D\u0437\u0438\u043D\u043E\u043C\u0026raquo;. \u0418 \u0441\u0438\u0434\u044F \u0441 \u041B\u0435\u043D\u043E\u0439 \u0438 \u0440\u044E\u043A\u0437\u0430\u043A\u043E\u043C \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u044F \u043E\u0441\u043E\u0437\u043D\u0430\u043B \u0447\u0442\u043E \u0026laquo;\u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u043A\u043B\u0443\u0431\u043E\u0432\u0441\u043A\u0438\u0435 \u0441\u0432\u043E\u0438\u0445 \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u044E\u0442\u0026raquo;. \u0410 \u0441 \u0431\u0435\u043D\u0437\u0438\u043D\u043E\u043C \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0438, \u043F\u043E\u0437\u0434\u043D\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043C\u044B \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438 \u0441 \u0410\u043F\u0430\u043D\u0430\u0441\u0435\u043D\u043A\u043E \u043D\u0430 \u0421\u044B\u044E \u0438 \u043E\u0442\u043B\u0438\u043B\u0438 \u0421\u043B\u0430\u0432\u043A\u0435 \u0431\u0435\u043D\u0437\u0438\u043D \u0438\u0437 \u0421\u0435\u0440\u0435\u0433\u0438\u043D\u043E\u0439 \u043C\u0430\u0448\u0438\u043D\u044B. \u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0421\u043B\u0430\u0432\u043A\u0430 \u0442\u043E\u0436\u0435 \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F, \u0447\u0442\u043E \u043C\u044B \u043F\u0440\u0438\u0435\u0434\u0435\u043C, \u0445\u043E\u0442\u044F \u043E\u0431 \u044D\u0442\u043E\u043C \u0435\u043C\u0443 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041F\u0440\u043E\u0441\u0442\u043E \u044F \u0442\u043E\u0436\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0442\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0026laquo;\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0026raquo;.\u003C/p\u003E\r\n\u003Cp\u003E\u0412 \u043A\u043B\u0443\u0431 \u041B\u0435\u043D\u0430 \u043F\u0440\u0438\u0448\u043B\u0430 \u043D\u0430 \u0420\u0422\u0424. \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430: \u0441\u043F\u043E\u0440\u0442\u043E\u043C \u044F \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u043D\u0430 \u0420\u0422\u0424, \u0442\u0443\u0441\u0443\u044E\u0441\u044C \u043D\u0430 \u0424\u042D\u0422\u0435, \u0430 \u043F\u0430\u0440\u0435\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u0441 \u041A\u0422\u0424. \u042F \u0438\u043D\u0442\u0435\u0440\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u0438\u0441\u0442\u043A\u0430!!! \u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u0432\u043E\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0432 \u043A\u043B\u0443\u0431\u0435. \u0422\u0435\u043C \u0431\u043E\u043B\u0435\u0435, \u0447\u0442\u043E \u043E\u0431\u0449\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432 \u0445\u0432\u0430\u0442\u0430\u043B\u043E: \u043C\u0443\u0437\u044B\u043A\u0430, \u043A\u043D\u0438\u0433\u0438, \u0441\u043F\u043E\u0440\u0442, \u0438 \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0026ndash; \u0433\u043E\u0440\u044B. \u041E\u043D\u0430 \u043E\u0447\u0435\u043D\u044C \u0440\u0432\u0430\u043B\u0430\u0441\u044C \u0442\u0443\u0434\u0430, \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u0435\u0445\u0430\u0442\u044C \u043D\u0430 \u0441\u0431\u043E\u0440\u044B. \u041A\u0430\u043A-\u0442\u043E \u043D\u0430 \u043B\u0435\u0434\u043E\u0432\u044B\u0445 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445 \u0432 \u041C\u0438\u0440\u043D\u043E\u043C \u043A \u043D\u0430\u043C \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0430 \u0413\u0430\u043B\u0438\u043D\u0430 \u041D\u043E\u0432\u043E\u0441\u0435\u043B\u043E\u0432\u0430. \u041A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 \u0026ndash; \u043D\u0430 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u0435, \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439, \u043F\u043B\u0435\u0449\u0443\u0449\u0435\u0439 \u0447\u0435\u0440\u0435\u0437 \u043A\u0440\u0430\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439, \u0442\u0430\u043A\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0447\u0442\u043E \u0432\u0441\u0435\u0445 \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u0431\u043D\u0438\u043C\u0435\u0442 \u0438 \u0440\u0430\u0441\u0446\u0435\u043B\u0443\u0435\u0442. \u041B\u0435\u043D\u0430 \u0443 \u043C\u0435\u043D\u044F \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430: \u0026laquo;\u0410 \u043A\u0442\u043E \u044D\u0442\u043E?\u0026raquo; \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0435\u0439: \u0026laquo;\u044D\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0441\u0431\u043E\u0440\u043E\u0432\u0026raquo;, \u043E\u043D\u0430: \u0026laquo;\u0412\u043E\u0442 \u0431\u044B \u0441 \u043D\u0435\u0439 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u0441\u044F!\u0026raquo; - \u0026laquo;\u0414\u0430 \u0432 \u0447\u0435\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430?, \u0441\u043E\u0431\u0435\u0440\u0435\u043C\u0441\u044F \u0432 \u0433\u043E\u0440\u044B \u0026ndash; \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043C\u0441\u044F!!!\u0026raquo;. \u0413\u043E\u0434 \u0441\u043F\u0443\u0441\u0442\u044F \u044F \u043F\u043E\u0435\u0445\u0430\u043B \u0432 \u0424\u0430\u043D\u044B \u0441 \u0413\u0430\u043B\u043A\u043E\u0439, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E \u043E\u0434\u0438\u043D.\u003C/p\u003E","Position":16,"CreateTime":"2012-05-15T04:53:41","Comment":"\u0424\u0435\u0434\u043E\u0442\u043E\u0432 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440","Active":1},{"Id":72,"PersonId":5,"Name":"\u0420\u043E\u043B\u0438\u043A \u043E \u041B\u0435\u043D\u0435","ResourceType":"video","Rubric":"gallery","Data":"http://inmemoria.tusur.ru/media/5/20120530115235.flv","Position":17,"CreateTime":"2012-05-30T04:52:35","Comment":"\u0420\u043E\u043B\u0438\u043A \u043E \u041B\u0435\u043D\u0435","Active":1},{"Id":73,"PersonId":5,"Name":"\u0022\u041C\u0430\u0440\u0438\u044F \u041C\u0430\u0433\u0434\u0430\u043B\u0435\u043D\u0430\u0022 \u041E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435","ResourceType":"video","Rubric":"gallery","Data":"http://inmemoria.tusur.ru/media/5/20120530115509.flv","Position":18,"CreateTime":"2012-05-30T04:55:09","Comment":"\u0022\u041C\u0430\u0440\u0438\u044F \u041C\u0430\u0433\u0434\u0430\u043B\u0435\u043D\u0430\u0022 \u041E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435","Active":1},{"Id":627,"PersonId":5,"Name":"\u041A\u043E\u043D\u0446\u0435\u0440\u0442-1 \u0447\u0430\u0441\u0442\u044C","ResourceType":"audio","Rubric"