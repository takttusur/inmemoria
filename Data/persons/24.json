    {
      "Title": "\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0421\u0442\u0435\u043F\u043D\u043E\u0439 \u0412\u0438\u043A\u0442\u043E\u0440",
      "Subtitle": "\u0421\u0442\u0435\u043F\u043D\u043E\u0439 \u0412\u0438\u043A\u0442\u043E\u0440",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u041C\u0430\u0439\u0441\u043A\u0438\u0439 \u0441\u043B\u0435\u0442 1968\u0433, \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u0435\u0442 \u0432 \u043C\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438. \u0421\u043E \u0441\u043B\u0435\u0442\u0430 \u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0431\u0435\u0437 \u0433\u043E\u043B\u043E\u0441\u0430, \u0430 \u0432\u0441\u0435\u043C\u0443 \u0432\u0438\u043D\u043E\u0439 \u0026ndash; \u0434\u043E\u043C\u0431\u0430\u0439\u0441\u043A\u0438\u0439 \u0431\u043E\u043A\u0441, \u0440\u0435\u0433\u0431\u0438 \u0432 \u0441\u0432\u044F\u0437\u043A\u0430\u0445, \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0444\u0443\u0442\u0431\u043E\u043B. \u041A\u043E\u043C\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043B \u0438\u0445 \u0432\u0441\u0435 \u0412\u043E\u043B\u044C\u043A\u0430 \u041C\u0430\u0449\u0435\u043D\u043A\u043E. \u041E\u043D, \u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u043B \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u043A\u0441\u0435\u0440\u0430 \u043A\u043B\u0438\u0447\u043A\u043E\u0439 \u0026laquo;\u043E\u0431\u0441\u0442\u0443\u043B\u0443\u0445\u043E\u043C\u0431\u0435\u0439\u0026raquo;, \u0442\u043E \u0433\u043E\u043B\u043E\u0441\u043E\u043C \u041B\u0435\u0432\u0438\u0442\u0430\u043D\u0430 \u0441\u043E\u043E\u0431\u0449\u0430\u043B, \u043A\u0430\u043A\u0438\u0435 \u0440\u043E\u0434\u0430 \u0432\u043E\u0439\u0441\u043A \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0442\u0441\u044F \u043A \u0442\u0440\u0438\u0431\u0443\u043D\u0430\u043C \u043D\u0430 \u0432\u043E\u0435\u043D\u043D\u043E\u043C \u043F\u0430\u0440\u0430\u0434\u0435. \u041D\u0438\u043A\u0430\u043A\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0442\u0443 \u0430\u0443\u0440\u0443, \u0447\u0442\u043E \u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0430 \u043E\u0442 \u0412\u043E\u043B\u044C\u043A\u0438, \u0435\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u0435\u0442\u044C \u0438 \u0441\u043B\u044B\u0448\u0430\u0442\u044C.\u003C/p\u003E",
