{
  "FirstName": "\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D",
  "LastName": "\u041C\u0430\u0449\u0435\u043D\u043A\u043E",
  "MaidenName": "",
  "Patronymic": "\u0413\u0440\u0438\u0433\u043E\u0440\u044C\u0435\u0432\u0438\u0447",
  "Nickname": "\u0412\u043E\u043B\u044C\u043A\u0430",
  "Birthday": "1940-04-10T00:00:00Z",
  "DeathDay": "1986-08-25T00:00:00Z",
  "Biography": "\u003Cp\u003E\u041C\u0430\u0449\u0435\u043D\u043A\u043E \u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D \u0413\u0440\u0438\u0433\u043E\u0440\u044C\u0435\u0432\u0438\u0447 (\u0434\u043B\u044F \u0432\u0441\u0435\u0445 - \u0412\u043E\u043B\u044C\u043A\u0430) \u0440\u043E\u0434\u0438\u043B\u0441\u044F 10 \u0430\u043F\u0440\u0435\u043B\u044F 1940\u0433. \u0412 1967\u0433. \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u041A\u0422\u0424 \u0422\u0418\u0420\u0438\u042D\u0422, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0022\u0414\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438 \u0438 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0438\u0022. \u041D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u043A\u0443\u0440\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u0422\u0418\u0420\u0438\u042D\u0422\u0435 \u0026nbsp;(\u0422\u0423\u0421\u0423\u0420\u0435) \u043D\u0430 \u043A\u0430\u0444\u0435\u0434\u0440\u0435 \u0421\u0412\u0427, \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F \u0440\u043E\u0441\u0442\u0430 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432 (1967 \u0026ndash; 1973\u0433\u0433.). \u0417\u0430\u0442\u0435\u043C \u0443\u0435\u0445\u0430\u043B \u0432 \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A.\u003C/p\u003E\r\n\u003Cp\u003E\u0436\u0435\u0442\u043E\u043D \u0026laquo;\u0412\u0435\u0442\u0435\u0440\u0430\u043D \u0422\u0410\u041A\u0422\u0026raquo; \u2116 21 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438, 2 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0439 \u0440\u0430\u0437\u0440\u044F\u0434 \u043F\u043E \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0437\u043C\u0443, \u043C\u043B\u0430\u0434\u0448\u0438\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440 \u043F\u043E \u0026nbsp;\u0442\u0443\u0440\u0438\u0437\u043C\u0443.\u003C/p\u003E\r\n\u003Cp\u003E\u0411\u043E\u0441\u0441 \u0424\u042D\u0422\u0430 1965-1966\u0433\u0433. \u0411\u043E\u0441\u0441 \u0420\u0423\u0424/\u041A\u0422\u0424 1966-1967\u0433\u0433.\u003C/p\u003E\r\n\u003Cp\u003E\u0423\u043C\u0435\u0440 25 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 1986\u0433. \u0432 \u0433.\u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0435\u003C/p\u003E\r\n\u003Cdiv\u003E\u0026nbsp;\u003C/div\u003E",
  "Active": true,
