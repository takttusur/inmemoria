043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0428\u0432\u0430\u0440\u0446\u043C\u0430\u043D \u0413\u0440\u0438\u0433\u043E\u0440\u0438\u0439 \u0418\u0441\u0430\u043A\u043E\u0432\u0438\u0447","ResourceType":0,"Rubric":1,"Data":"\u003Cp\u003E\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0445\u043E\u0447\u0443 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C \u0412. \u041C\u0430\u0449\u0435\u043D\u043A\u043E, \u041D. \u0414\u043E\u0440\u043E\u0433\u0438\u043D\u0430, \u0410. \u0417\u0435\u0440\u043D\u043E\u0432\u0430, \u0421\u0435\u0440\u0433\u0435\u044F \u0438 \u041E\u043B\u044E \u041A\u0443\u0436\u0435\u043B\u0435\u0432\u044B\u0445. \u0412\u0441\u0435 \u043E\u043D\u0438 \u0431\u044B\u043B\u0438 \u043C\u043E\u0438\u043C\u0438 \u0434\u0438\u043F\u043B\u043E\u043C\u043D\u0438\u043A\u0430\u043C\u0438, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B\u0438 \u043A\u0443\u0440\u0441\u043E\u0432\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B. \u0414\u0435\u043B\u043E \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0432 1965 \u0433\u043E\u0434\u0443 \u043F\u0440\u0438 \u043A\u0430\u0444\u0435\u0434\u0440\u0435 \u0421\u0412\u0427 \u0422\u0418\u0420\u0438\u042D\u0422\u0430 \u0431\u044B\u043B\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u0430, \u043F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u0415.\u0421. \u041A\u043E\u0432\u0430\u043B\u0435\u043D\u043A\u043E, \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F \u0026laquo;\u0420\u043E\u0441\u0442\u0430 \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432\u0026raquo;, \u0438 \u044F (\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C \u0440\u0430\u0431\u043E\u0442) \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0026laquo;\u0414\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438 \u0438 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0438\u0026raquo;. \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438, \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u0438 \u043F\u043E\u043B\u0441\u0442\u0430\u0432\u043A\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u043D\u0442\u0430. \u041F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0442\u0431\u043E\u0440\u0430: \u0442\u0443\u0440\u0438\u0441\u0442\u044B, \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0441\u0442\u044B \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C. \u041C\u043D\u043E\u0433\u043E \u0431\u044B\u043B\u043E \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439, \u043D\u043E \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u0431\u044B\u043B\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u044D\u0442\u043E\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 (\u044F \u0432 \u044D\u0442\u0438\u0445 \u0433\u0440\u0443\u043F\u043F\u0430\u0445 \u0432\u0435\u043B \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044F \u0438 \u0447\u0438\u0442\u0430\u043B \u043B\u0435\u043A\u0446\u0438\u0438 \u043F\u043E \u043A\u0443\u0440\u0441\u0443 \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B).\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u0438\u043F\u043B\u043E\u043C\u043E\u0432 \u0412. \u041C\u0430\u0449\u0435\u043D\u043A\u043E, \u0430 \u0437\u0430\u0442\u0435\u043C \u0421. \u041A\u0443\u0436\u0435\u043B\u0435\u0432 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430\u043C\u0438 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438. \u042D\u0442\u043E \u0431\u044B\u043B\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438, \u0430 \u0431\u043B\u0438\u0437\u043A\u0438\u0435 \u043C\u043D\u0435 \u043B\u044E\u0434\u0438, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0412 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u043A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B, \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B \u043D\u0430 \u043D\u043E\u0447\u043D\u044B\u0435 \u0434\u0435\u0436\u0443\u0440\u0441\u0442\u0432\u0430, \u043A\u0442\u043E-\u0442\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B \u043A\u0443\u0440\u0441\u043E\u0432\u0443\u044E, \u043A\u0442\u043E-\u0442\u043E \u0434\u0438\u043F\u043B\u043E\u043C\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443. \u041F\u043E \u043F\u0440\u043E\u0448\u0435\u0441\u0442\u0432\u0438\u0438 \u043B\u0435\u0442 \u043C\u043D\u043E\u0433\u0438\u0435, \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0443\u044E, \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438, \u0447\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0438\u043F\u043B\u043E\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043A\u0430\u043A \u0441\u0430\u043C\u043E\u0435 \u0441\u0432\u0435\u0442\u043B\u043E\u0435 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u043E \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0441\u043A\u0438\u0445 \u0433\u043E\u0434\u0430\u0445. \u0416\u0438\u043B\u0438 \u0442\u0440\u0443\u0434\u043D\u043E, \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C \u043B\u044E\u0431\u0438\u043C\u044B\u043C, \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C \u0434\u0435\u043B\u043E\u043C \u0438 \u0431\u044B\u043B\u0438 \u043C\u043E\u043B\u043E\u0434\u044B \u0438 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B.\u0026nbsp;\u003C/p\u003E\r\n\u003Cdiv\u003E\u0026nbsp;\u003C/div\u003E","Position":2,"CreateTime":"0001-01-01T00:00:00","Comment":"\u0428\u0432\u0430\u0440\u0446\u043C\u0430\u043D \u0413\u0440\u0438\u0433\u043E\u0440\u0438\u0439 \u0418\u0441\u0430\u043A\u043E\u0432\u0438\u0447","Active":1},{"Id":335,"PersonId":0,"Name":"\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u041D\u0435\u043A\u0440\u0430\u0441\u043E\u0432 \u0022\u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447 \u0438 \u0412\u043E\u043B\u044C\u043A\u0430\u0022","ResourceType":0,"Rubric":1,"Data":"http://inmemoria.tusur.ru/media/24/20120817235123.doc","Position":3,"CreateTime":"0001-01-01T00:00:00","Comment":"\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u041D\u0435\u043A\u0440\u0430\u0441\u043E\u0432 \u0022\u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447 \u0438 \u0412\u043E\u043B\u044C\u043A\u0430\u0022","Active":1},{"Id":336,"PersonId":0,"Name":"\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D \u041C\u0430\u0449\u0435\u043D\u043A\u043E",