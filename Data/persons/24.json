    {
      "Title": "\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432 \u0413.",
      "Subtitle": "\u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432 \u0413\u0435\u043D\u043D\u0430\u0434\u0438\u0439",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u041C\u0430\u0449\u0435\u043D\u043A\u043E \u0412\u043E\u043B\u044C\u043A\u0435\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0417\u0432\u0443\u043A\u0438 \u0441\u043A\u043E\u0440\u0431\u043D\u043E\u0439 \u043C\u0435\u043B\u043E\u0434\u0438\u0438\u003C/p\u003E\r\n\u003Cp\u003E\u0421\u0435\u0440\u0434\u0446\u0435 \u0026nbsp;\u0446\u0430\u0440\u0430\u043F\u0430\u044E\u0442 \u0436\u0435\u0441\u0442\u043A\u043E\u003C/p\u003E\r\n\u003Cp\u003E\u0412\u043E\u0442 \u0438 \u0442\u043E\u0431\u043E\u0439, \u0412\u043E\u043B\u044C\u043A\u0430, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u003C/p\u003E\r\n\u003Cp\u003E\u041D\u0430 \u044D\u0442\u043E\u043C \u043F\u0443\u0442\u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u0435\u0441\u0442\u043E\u043A\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0422\u0435\u0431\u0435 \u0432 \u0441\u0442\u0440\u0430\u043D\u0443 \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u043D\u0443\u044E\u003C/p\u003E\r\n\u003Cp\u003E\u0413\u0434\u0435 \u0442\u0438\u0445\u043E \u0441\u043F\u044F\u0442 \u043E\u0431\u043B\u0430\u043A\u0430\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C \u0437\u0430\u043E\u0431\u043B\u0430\u0447\u043D\u044B\u043C\u003C/p\u003E\r\n\u003Cp\u003E\u041D\u0430\u043C, \u0433\u0440\u0435\u0448\u043D\u044B\u043C, \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E\u043A\u0430\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0427\u0435\u0440\u043D\u0435\u0435\u0442 \u043A\u0440\u0435\u0441\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u043A\u0440\u0435\u0441\u0442\u043E\u043A\u003C/p\u003E\r\n\u003Cp\u003E\u0421\u0443\u0434\u044C\u0431\u044B \u0442\u0432\u043E\u0435\u0439 \u0442\u044F\u0436\u043A\u0438\u0439 \u043A\u0440\u0435\u0441\u0442\u003C/p\u003E\r\n\u003Cp\u003E\u041A\u0430\u043A \u0441\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u043D\u0435\u