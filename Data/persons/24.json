    {
      "Title": "1966\u0433 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 5 \u043A.\u0441.",
      "Subtitle": "",
      "IsActive": true,
      "Data": "\u003Cp\u003E1966\u0433 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u0026nbsp;5 \u043A.\u0441. \u043F\u043E \u0413\u043E\u0440\u043D\u043E\u043C\u0443 \u0410\u043B\u0442\u0430\u044E.\u003C/p\u003E\r\n\u003Cp\u003E\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C: \u0421\u0438\u0434\u043E\u0440\u043E\u0432 \u042E\u0440\u0438\u0439.\u0026nbsp;\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438: \u0411\u043E\u0440\u0435\u0446\u043A\u0430\u044F \u041C\u0430\u0440\u0438\u043D\u0430, \u041A\u0430\u0437\u0430\u043A\u043E\u0432\u0430 \u041B\u044E\u0434\u043C\u0438\u043B\u0430, \u041C\u0430\u0449\u0435\u043D\u043A\u043E \u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D, \u041F\u0435\u0442\u0440\u043E\u0432 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440, \u0420\u043E\u0434\u0438\u043E\u043D\u043E\u0432 \u041D\u0438\u043A\u043E\u043B\u0430\u0439, \u0422\u043E\u043C\u0438\u0448 \u0413\u0430\u043B\u0438\u043D\u0430, \u0413\u0430\u0435\u0432 \u0410\u043B\u0435\u043A\u0441\u0435\u0439. \u0026nbsp;\u041C\u0430\u0440\u0448\u0440\u0443\u0442: \u0418\u043D\u044F \u0026ndash; \u0428\u0430\u0432\u043B\u0438\u043D\u0441\u043A\u0438\u0435 \u043E\u0437\u0435\u0440\u0430 \u0026ndash; \u0420\u0430\u0445\u043C\u0430\u043D\u043E\u0432\u0441\u043A\u0438\u0435 \u043A\u043B\u044E\u0447\u0438\u003C/p\u003E",
