30","IsActive":true,"Data":"20120913172920.jpg","Category":0,"AttachmentType":0,"Order":3,"CreatedAt":"2012-09-13T10:29:20","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0412\u0430\u043C\u0431\u043E\u043B\u044C\u0434\u0442 (\u0424\u0438\u0441\u0435\u043D\u043A\u043E) \u041B\u044E\u0431\u043E\u0432\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440","Subtitle":"\u0412\u0430\u043C\u0431\u043E\u043B\u044C\u0434\u0442 (\u0424\u0438\u0441\u0435\u043D\u043A\u043E) \u041B\u044E\u0431\u043E\u0432\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u043D\u0430","IsActive":true,"Data":"\u003Cp\u003E\u041F\u0440\u043E \u041C\u0438\u0448\u0443 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u043A\u043D\u0438\u0433\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u0026ndash; \u0026laquo;\u0423\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0422\u0410\u041A\u0422\u0430\u0026raquo;. \u042F \u0443\u0436\u0435 \u0443\u0435\u0445\u0430\u043B\u0430 \u0438\u0437 \u0422\u043E\u043C\u0441\u043A\u0430, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0441\u0442\u0430\u043B \u0026laquo;\u0431\u043E\u0441\u0441\u043E\u043C\u0026raquo; \u043A\u043B\u0443\u0431\u0430 \u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0441\u0432\u043E\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0446\u0435\u043D\u0438\u043B \u0434\u0430\u0436\u0435 \u0412\u0438\u043A\u0442\u043E\u0440 \u0417\u0430\u0439\u0446\u0435\u0432. \u0410 \u044D\u0442\u043E \u043C\u043D\u043E\u0433\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442! \u041C\u043D\u0435 \u0436\u0435 \u043E\u043D \u0437\u043D\u0430\u043A\u043E\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043A \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043D\u0430\u0448\u0435\u0433\u043E \u043B\u044B\u0436\u043D\u043E\u0433\u043E \u043F\u043E\u0445\u043E\u0434\u0430 \u043F\u043E \u0413\u043E\u0440\u043D\u043E\u0439 \u0428\u043E\u0440\u0438\u0438 \u0432 1973 \u0433\u043E\u0434\u0443. \u041E\u043D \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0441\u044F \u0442\u0430\u043A \u043D\u0430\u043C\u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u044C, \u0447\u0442\u043E \u043B\u0438\u0447\u043D\u043E \u044F \u044D\u0442\u043E\u0433\u043E \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430. \u041D\u043E \u0441 \u043F\u0443\u0442\u0438 \u043C\u044B \u043D\u0435 \u0441\u0431\u0438\u043B\u0438\u0441\u044C, \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0431\u043C\u043E\u0440\u043E\u0437\u0438\u043B\u0441\u044F, \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043B\u044B\u0436\u0438 \u0438\u043B\u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0438, \u0438 \u0434\u0430\u0436\u0435 \u0437\u0430\u043D\u044F\u043B \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u043C\u0435\u0441\u0442\u043E, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u0430\u0436\u0435 \u043F\u0435\u0440\u0432\u043E\u0435, \u0432\u043E \u0432\u0441\u0435\u0441\u043E\u044E\u0437\u043D\u043E\u043C \u043F\u0435\u0440\u0432\u0435\u043D\u0441\u0442\u0432\u0435 \u043C\u0435\u0436\u0434\u0443 \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u043C\u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F\u043C\u0438. (\u041C\u043D\u0435 \u0432\u0440\u0443\u0447\u0438\u043B\u0438 \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0441\u043B\u0443\u0447\u0430\u044E, \u043A\u043E\u0433\u0434\u0430 \u044F \u0433\u043E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u043B\u0430 \u043D\u0430 \u043C\u0430\u0439\u0441\u043A\u0438\u0439 \u0441\u043B\u0451\u0442, \u0443\u0436\u0435 \u0443\u0447\u0430\u0441\u044C \u043D\u0430 \u0433\u0435\u043E\u043B\u043E\u0433\u0430 \u0432 \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0435). \u041D\u043E \u043A\u043E\u0433\u0434\u0430, \u043F\u0440\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0443\u0442\u0440\u043E\u043C, \u044F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0434 \u0442\u043E\u043B\u0441\u0442\u044B\u043C \u0441\u043B\u043E\u0435\u043C \u0432\u044B\u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0437\u0430 \u043D\u043E\u0447\u044C \u0441\u043D\u0435\u0433\u0430 \u043D\u0430\u0439\u0442\u0438 \u0441\u0432\u043E\u0438 \u0026laquo;\u043A\u043E\u0448\u043A\u0438\u0026raquo;, \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0432\u043E\u0437\u043B\u0435 \u043F\u0430\u043B\u0430\u0442\u043A\u0438, \u043E\u043D \u043E\u0434\u0430\u0440\u0438\u043B \u043C\u0435\u043D\u044F \u0441\u0432\u043E\u0435\u0439 \u043D\u0435\u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043C\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043E\u0437\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043B\u043D\u043E\u0435 \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0435 \u043C\u043E\u0435\u0433\u043E \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u0432\u0438\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0430. \u0418 \u044D\u0442\u043E\u0433\u043E \u0431\u044B\u043B\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u044F \u0443\u0436\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u043B\u0430 \u0441\u0432\u043E\u0439 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C, \u0433\u0434\u0435 \u043F\u043E\u043F\u0430\u043B\u043E. \u0410 \u0442\u0435 \u0026laquo;\u043A\u043E\u0448\u043A\u0438\u0026raquo; \u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u0430\u0448\u043B\u0430.\u003C/p\u003E\r\n\u003Cp\u003E\u041E \u041C\u0438\u0448\u043A\u0438\u043D\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437. \u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0438 \u0435\u0433\u043E \u043D\u0435\u043E\u0442\u044A\u0435\u043C\u043B\u0435\u043C\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E, \u0438 \u0436\u0438\u043B\u0430 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u044C\u044E. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u044D\u0442\u0430, \u0441 \u0432\u0438\u0434\u0443 \u0434\u0430\u0436\u0435 \u0437\u0430\u0441\u0442\u0435\u043D\u0447\u0438\u0432\u0430\u044F, \u0443\u043B\u044B\u0431\u043A\u0430, \u043C\u043E\u0433\u043B\u0430 \u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443, \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u043E\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435, \u043D\u043E \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438 \u0441 \u0026laquo;\u0447\u0451\u0440\u0442\u0438\u043A\u0430\u043C\u0438\u0026raquo;, \u043F\u0440\u044B\u0433\u0430\u044E\u0449\u0438\u043C\u0438 \u0432 \u043C\u0438\u0448\u0438\u043D\u044B\u0445 \u0433\u043B\u0430\u0437\u0430\u0445, \u043F\u043E\u0440\u043E\u0439 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u043C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0430, \u043B\u0435\u0433\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u0438\u0446\u0430\u043D\u0438\u044F. \u041C\u043E\u0436\u0435\u0442 \u043E\u043D \u043C\u043E\u0433 \u0438 \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u0442\u044C\u0441\u044F, \u043D\u043E \u044F \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0430. \u0418 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u044D\u0442\u043E\u0442 \u0441\u0430\u0440\u043A\u0430\u0437\u043C, \u0441\u043A\u0432\u043E\u0437\u044F\u0449\u0438\u0439 \u0432 \u0443\u043B\u044B\u0431\u043A\u0435, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043A\u0430\u043A \u0026laquo;\u043A\u0438\u0448\u043A\u0430\u0026raquo; \u0431\u043E\u043B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438\u043D\u0435 \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F \u0434\u0430\u0436\u0435 \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u0438\u043B\u0438 \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E \u043E\u0442\u043B\u044B\u043D\u0438\u0432\u0430\u0435\u0448\u044C \u043E\u0442 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043B\u0430\u043F\u043D\u0438\u043A\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043F\u043E\u0441\u043B\u0435 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430, \u044D\u0442\u043E \u0431\u044B\u043B\u043E (\u043F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435, \u0434\u043B\u044F \u043C\u0435\u043D\u044F) \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0445\u0443\u0436\u0435 \u0441\u043B\u043E\u0432 \u043F\u043E\u0440\u0438\u0446\u0430\u043D\u0438\u044F.\u003C/p\u003E","Category":1,"