{"Id":28,"CardName":null,"FirstName":"\u0424\u0435\u043B\u0438\u043A\u0441 ","LastName":"\u041F\u0435\u0440\u0435\u0433\u0443\u0434\u043E\u0432","LastName2":"","Patronymic":"\u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447","Nickname":"","Birthday":"1931-01-20T00:00:00","DeathDay":"0001-01-01T00:00:00","Biography":"\u003Cp\u003E\u041F\u0435\u0440\u0435\u0433\u0443\u0434\u043E\u0432 \u0424\u0435\u043B\u0438\u043A\u0441 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 20 \u044F\u043D\u0432\u0430\u0440\u044F 1931 \u0433\u043E\u0434\u0430 \u0432 \u0433. \u0411\u043E\u0440\u0438\u0441\u043E\u0433\u043B\u0435\u0431\u0441\u043A\u0435 \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u0421\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443 \u043E\u043A\u043E\u043D\u0447\u0438\u043B \u0432 \u0433. \u041D\u043E\u0432\u043E\u0441\u0438\u0431\u0438\u0440\u0441\u043A\u0435 \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u043C\u0435\u0434\u0430\u043B\u044C\u044E \u0432 1948 \u0433\u043E\u0434\u0443. \u0412 1948\u0026mdash;1953\u0433\u0433. \u0443\u0447\u0438\u043B\u0441\u044F \u043D\u0430 \u0440\u0430\u0434\u0438\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0435 \u0422\u043E\u043C\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0438\u043F\u043B\u043E\u043C \u0441 \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C.\u003C/p\u003E\r\n\u003Cp\u003E\u0410\u0441\u043F\u0438\u0440\u0430\u043D\u0442, \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C \u0422\u041F\u0418 (1953\u0026ndash;1961\u0433\u0433.), \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E \u0026mdash; \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0431\u044E\u0440\u043E \u0026laquo;\u041F\u0440\u043E\u0435\u043A\u0442\u0026raquo; (1961\u0026ndash;1966\u0433\u0433.), \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0026mdash; \u0422\u043E\u043C\u0441\u043A\u043E\u0433\u043E \u0440\u0430\u0434\u0438\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0437\u0430\u0432\u043E\u0434\u0430 (1966\u0026ndash;1970\u0433\u0433.), \u0437\u0430\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430, \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u041D\u0418\u0418 \u0410\u042D\u041C \u043F\u0440\u0438 \u0422\u043E\u043C\u0441\u043A\u043E\u043C \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u0440\u0430\u0434\u0438\u043E\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0438 (1970\u0026ndash;1983\u0433\u0433.), \u0440\u0435\u043A\u0442\u043E\u0440 \u0422\u0418\u0410\u0421\u0423\u0420\u0430 (1981\u0026ndash;1983\u0433\u0433.), \u0437\u0430\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C \u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430 \u0432\u044B\u0441\u0448\u0435\u0433\u043E \u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0420\u0421\u0424\u0421\u0420 (1983\u0026ndash;1985\u0433\u0433.), \u0437\u0430\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043B\u044F \u0413\u043E\u0441\u043A\u043E\u043C\u0438\u0442\u0435\u0442\u0430 \u0421\u0421\u0421\u0420 \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044E, \u043C\u0438\u043D\u0438\u0441\u0442\u0440 \u0421\u0421\u0421\u0420 (1985\u0026ndash;1990\u0433\u0433.).\u003C/p\u003E\r\n\u003Cp\u003E\u041A\u0430\u043D\u0434\u0438\u0434\u0430\u0442 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043D\u0430\u0443\u043A \u0026mdash; 1959\u0433., \u0434\u043E\u0446\u0435\u043D\u0442 \u0026mdash; 1964\u0433., \u0434\u043E\u043A\u0442\u043E\u0440 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043D\u0430\u0443\u043A \u0026mdash; 1980\u0433., \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u0026mdash; 1981\u0433., \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0447\u043B\u0435\u043D (\u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C)\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0439 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438 \u0421\u0421\u0421\u0420 \u0026mdash; 1990\u0433.\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u0424.\u0418. \u041F\u0435\u0440\u0435\u0433\u0443\u0434\u043E\u0432\u0430 \u0432 1990 \u0433\u043E\u0434\u0443 \u0432 \u0422\u043E\u043C\u0441\u043A\u0435 \u0431\u044B\u043B \u043E\u0442\u043A\u0440\u044B\u0442 \u043F\u0435\u0440\u0432\u044B\u0439 \u0432 \u0441\u0442\u0440\u0430\u043D\u0435 \u0022\u0422\u0435\u0445\u043D\u043E\u043F\u0430\u0440\u043A\u0022, \u044F\u0432\u0438\u0432\u0448\u0438\u0439\u0441\u044F \u043D\u043E\u0432\u043E\u0439 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u043E\u0439 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438 \u043D\u0430\u0443\u043A\u0438, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.\u003C/p\u003E\r\n\u003Cp\u003E\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u0430\u044F \u0441\u043C\u0435\u0440\u0442\u044C \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u0430 \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u044E \u0440\u044F\u0434\u0430 \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432. \u0423\u043C\u0435\u0440 \u0424\u0435\u043B\u0438\u043A\u0441 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447 \u043D\u0430 \u0445\u043E\u0434\u0443 \u0026ndash; \u0432 \u043F\u043E\u0435\u0437\u0434\u0435 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434-\u041C\u043E\u0441\u043A\u0432\u0430 30 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 1990 \u0433\u043E\u0434\u0430.\u003C/p\u003E\r\n\u003Cp\u003E\u0412 \u043D\u043E\u044F\u0431\u0440\u0435 1996\u0433. \u0441\u043E\u0437\u0434\u0430\u043D \u0424\u043E\u043D\u0434 \u041F\u0435\u0440\u0435\u0433\u0443\u0434\u043E\u0432\u0430,\u043A\u043E\u0442\u043E\u0440\u044B\u0439\u0442 \u0438\u043D\u0438\u0446\u0438\u0438\u0440\u0443\u0435\u0442 \u0438 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0437\u043D\u0430\u0447\u0438\u043C\u044B\u0445 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445, \u0438\u043D\u0436\u04