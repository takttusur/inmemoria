0441\u043B\u043E\u0432\u0430. \u0418 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F. \u0412\u0438\u0434\u0438\u043C\u043E, \u0448\u043E\u043A, \u0447\u0442\u043E \u0435\u0433\u043E \u043D\u0435 \u0441\u0442\u0430\u043B\u043E, \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u043F\u0440\u043E\u0448\u0435\u043B. \u041D\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u043D\u0451\u043C, \u043D\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u043E \u043D\u0451\u043C \u043D\u0435\u043B\u044C\u0437\u044F. \u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0417\u043D\u0430\u0435\u0442\u0435, \u043A\u0430\u043A\u0438\u043C \u043E\u043D \u043F\u0430\u0440\u043D\u0435\u043C \u0431\u044B\u043B?\u0026nbsp;\u042F \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u044E: \u043C\u044B \u0438 \u0432 \u0433\u043E\u0440\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u0445\u043E\u0434\u0438\u043B\u0438, \u0438 \u0432 \u043F\u0435\u0449\u0435\u0440\u044B \u043B\u0430\u0437\u0438\u043B\u0438, \u0438 \u0432\u0441\u044F\u043A\u0438\u0435 \u0441\u043B\u0435\u0442\u044B-\u043A\u0440\u043E\u0441\u0441\u044B, \u0412\u043E\u043B\u043E\u0434\u044F \u0431\u044B\u043B \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u043C \u0026nbsp;\u043D\u0430 \u043D\u0430\u0448\u0435\u0439 \u0441 \u041D\u0430\u0442\u0430\u0448\u0435\u0439 \u0441\u0432\u0430\u0434\u044C\u0431\u0435\u0026hellip; \u0412\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u043A \u043C\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0435\u0445\u0430\u043B\u0438 \u0432 \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u041E\u0440\u0435\u0448\u043D\u0443\u044E \u043F\u0435\u0449\u0435\u0440\u0443 \u0441 \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E \u0026laquo;\u043E\u0442\u0441\u0438\u043D\u0435\u043D\u043D\u043E\u0439\u0026raquo; \u0434\u043E \u0026laquo;\u0431\u0435\u043B\u044B\u0445 \u043F\u044F\u0442\u0435\u043D\u0026raquo; \u043A\u0440\u043E\u043A\u043E\u0439. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u044B \u0445\u043E\u0442\u0435\u043B\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0438 \u0432\u0437\u044F\u043B\u0438 \u0431\u0438\u043B\u0435\u0442\u044B \u043D\u0430 \u043F\u043E\u0435\u0437\u0434 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0430. \u0410 \u0432 \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0435 \u0432\u043E\u0448\u043B\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u044B, \u0438 \u043C\u044B \u0431\u0435\u0433\u0430\u043B\u0438 \u043E\u0442 \u043D\u0438\u0445 \u043F\u043E \u043F\u043E\u0435\u0437\u0434\u0443 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp;\u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0441 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C\u0438 \u0431\u044B\u043B\u0430 \u0431\u0435\u0434\u0430, \u043C\u044B \u043E\u0447\u0435\u043D\u044C \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C, \u043A\u043E\u0433\u0434\u0430 \u0432 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u0430\u0432\u0442\u043E\u043B\u0430\u0432\u043A\u0443. \u041D\u043E \u0432 \u043D\u0435\u0439 \u043A\u0440\u043E\u043C\u0435 \u043F\u043E\u0432\u0438\u0434\u043B\u0430 \u0438\u0437 \u0433\u0443\u0430\u044F\u0431\u044B (1985\u0433\u043E\u0434!) \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E. \u041C\u044B \u0435\u0433\u043E \u043D\u0430\u0431\u0440\u0430\u043B\u0438, \u043D\u043E \u0432\u043A\u0443\u0441 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0026laquo;\u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439\u0026raquo;. \u042D\u0442\u043E\u0442 \u0432\u043A\u0443\u0441 \u0026nbsp;\u044F \u043F\u0440\u043E\u043D\u0451\u0441 \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u0435 \u0433\u043E\u0434\u044B\u0026hellip;\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp;\u041D\u0430\u0448\u043B\u0438, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u043F\u0435\u0449\u0435\u0440\u0443, \u0437\u0430\u043B\u0435\u0437\u043B\u0438. \u041A\u0442\u043E \u0431\u044B\u043B \u0432 \u041E\u0440\u0435\u0448\u043A\u0435 , \u0437\u043D\u0430\u0435\u0442: \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0437\u0430\u043B\u044B, \u043C\u043D\u043E\u0433\u043E \u0445\u043E\u0434\u043E\u0432, \u043C\u043D\u043E\u0433\u043E \u0442\u0443\u043F\u0438\u043A\u043E\u0432. \u0411\u0440\u043E\u0434\u0438\u043B\u0438 \u043C\u044B \u0442\u0430\u043C \u0447\u0430\u0441\u043E\u0432 12, \u0443\u043C\u043E\u0442\u0430\u043B\u0438\u0441\u044C. \u0410 \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u0441\u043F\u0435\u043B\u0435\u043E\u043B\u043E\u0433\u043E\u0432 \u0438\u0437 \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438 \u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0433\u0440\u043E\u0442 \u0438 \u043F\u0435\u0449\u0435\u0440\u0443 \u043E\u0442 \u043C\u0443\u0441\u043E\u0440\u0430. \u041F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u043D\u0430\u0441 \u043F\u043E\u043C\u043E\u0447\u044C \u0026laquo;\u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043F\u0430\u0440\u0443 \u043C\u0435\u0448\u043A\u043E\u0432\u0026raquo;. \u0418 \u0435\u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432 \u043C\u044B \u0442\u0430\u0441\u043A\u0430\u043B\u0438 \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u044B \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u043C\u0435\u0448\u043A\u0438 \u0441 \u043C\u0443\u0441\u043E\u0440\u043E\u043C. \u0423\u0445\u0430\u0439\u0434\u0430\u043A\u0430\u043B\u0438\u0441\u044C \u0442\u0430\u043A, \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0435\u0441\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u043B\u0438.\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp;\u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C, \u043A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0446\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u043D\u0430\u043C \u0434\u043E\u0435\u0445\u0430\u0442\u044C \u0434\u043E \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0441\u043A\u0430 \u043D\u0430 \u0438\u0445 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0435. \u0414\u043E\u0440\u043E\u0433\u0430 \u0431\u044B\u043B\u0430 \u0441\u0442\u0430\u0440\u043E\u0439 \u0431\u0435\u0442\u043E\u043D\u043A\u043E\u0439, \u043F\u043B\u0438\u0442\u044B \u0447\u0430\u0441\u0442\u043E \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u043B\u0438, \u0442\u0440\u044F\u0441\u043B\u043E, \u043C\u044F\u0433\u043A\u043E \u0433\u043E\u0432\u043E\u0440\u044F, \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E. \u041A\u043E\u0433\u0434\u0430 \u0432\u043E\u0448\u043B\u0438 \u0432 \u0430\u0432\u0442\u043E\u0431\u0443\u0441, \u0443\u0434\u0438\u0432\u0438\u043B\u0438\u0441\u044C, \u0447\u0442\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0446\u044B \u0441\u0430\u043C\u0438 \u043D\u0435 \u0437\u0430\u043D\u044F\u043B\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0434\u0438\u0432\u0430\u043D \u0432 \u043A\u043E\u043D\u0446\u0435 \u0441\u0430\u043B\u043E\u043D\u0430, \u0445\u043E\u0442\u044F \u0432\u0441\u0435 \u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C \u0441 \u043D\u043E\u0433 \u043E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438. \u0420\u0430\u0437\u0433\u0430\u0434\u043A\u0430 \u043F\u0440\u0438\u0448\u043B\u0430 \u0441\u0440\u0430\u0437\u0443, \u043A\u0430\u043A \u0430\u0432\u0442\u043E\u0431\u0443\u0441 \u0026nbsp;\u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F: \u0026nbsp;\u043D\u0430 \u0441\u0442\u044B\u043A\u0430\u0445 \u043F\u043B\u0438\u0442 \u0442\u0440\u044F\u0441\u043B\u043E \u0442\u0430\u043A, \u0447\u0442\u043E \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u0435\u0442\u0430\u043B\u0438 \u0441 \u044D\u0442\u043E\u0433\u043E \u0434\u0438\u0432\u0430\u043D\u0447\u0438\u043A\u0430 \u043D\u0430 \u043F\u043E\u043B! \u0427\u0442\u043E\u0431\u044B \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043D\u0435 \u0431\u0438\u0442\u044C\u0441\u044F \u043E \u0441\u0438\u0434\u0435\u043D\u0438\u0435, \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0440\u0443\u043A\u0430\u043C\u0438 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u0433\u043E\u043B\u043E\u0432\u0443. \u0422\u0430\u043A \u0438 \u0026laquo;\u0441\u043F\u0430\u043B\u0438\u0026raquo;. \u0424\u0430\u0440\u044B \u043E\u0441\u0432\u0435\u0449\u0430\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F, \u0430 \u043D\u0430\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E \u043C\u044B \u0435\u0434\u0435\u043C \u043F\u043E \u043F\u0435\u0449\u0435\u0440\u0435 \u0438 \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0438\u0433\u0438\u0431\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u044B, \u0447\u0442\u043E\u0431\u044B \u0026laquo;\u043D\u0435 \u0443\u0434\u0430\u0440\u0438\u0442\u044C\u0441\u044F \u043E \u0441\u0432\u043E\u0434\u0026raquo;. \u041A\u0440\u0430\u0441\u043D\u043E\u044F\u0440\u0446\u044B \u043F\u0440\u0438\u0432\u0435\u0437\u043B\u0438 \u043D\u0430\u0441 \u0432 \u0441\u0432\u043E\u0439 \u043A\u043B\u0443\u0431, \u043D\u0430\u043F\u043E\u0438\u043B\u0438 \u0447\u0430\u0435\u043C\u0026hellip;\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp;\u0412 \u0442\u0430\u043A\u0438\u0435 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u0435\u0437\u0434\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043E\u043F\u0442\u0438\u043C\u0438\u0441\u0442\u0430\u043C\u0438. \u0412\u043E\u043B\u043E\u0434\u044F \u0438 \u0431\u044B\u043B \u0442\u0430\u043A\u0438\u043C \u043E\u043F\u0442\u0438\u043C\u0438\u0441\u0442\u043E\u043C. \u0412\u0441\u0435 \u0026laquo;\u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438\u0026raquo;-\u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F \u0442\u0435\u0445 \u043B\u0435\u0442 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0435\u0433\u043E \u0443\u043B\u044B\u0431\u043A\u0430. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0447\u0442\u043E \u0422\u0410\u041A\u0422 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0441\u043F\u0430\u0441\u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0430\u043C\u044F\u0442\u0438 \u0412\u043E\u043B\u043E\u0434\u0438.\u003C/p\u003E","Position":4,"CreateTime":"0001-01-01T00:00:00","Comment":"\u041E\u043B\u0435\u0433 \u0414\u0435\u0440\u0433\u0430\u043B\u0435\u043D\u043A\u043E","Active":1}]}