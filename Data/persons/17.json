E\u043B\u0435\u0433 \u0422\u0430\u0431\u0435\u043B\u0435\u0432, \u0435\u0435 \u043C\u0443\u0436, \u043D\u0430 \u0420\u0422\u0424. \u0424\u042D\u0422\u043E\u0432\u0446\u0435\u0432 \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u043D\u0430\u0441 \u043D\u0435 \u0431\u044B\u043B\u043E. :) \u0026nbsp;\u0423 \u0412\u043E\u043B\u043E\u0434\u0438 \u0431\u044B\u043B \u0432\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0440\u043E\u043A \u0441\u0435\u0440\u0434\u0446\u0430 \u0438 \u0440\u043E\u0441 \u043E\u043D \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u043C \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C. \u041A\u0430\u0436\u0435\u0442\u0441\u044F \u0435\u043C\u0443 \u0432\u0440\u0430\u0447\u0438 \u0437\u0430\u043F\u0440\u0435\u0442\u0438\u043B\u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0441\u043F\u043E\u0440\u0442\u043E\u043C. \u041D\u0435 \u0437\u043D\u0430\u044E \u043A\u0430\u043A \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B\u0438 \u043D\u0430 \u0435\u0433\u043E \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0432 \u0422\u0410\u041A\u0422. \u0026nbsp;\u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0431\u044B\u043B \u0440\u0430\u0434 \u0447\u0442\u043E \u043E\u043D \u0437\u0430\u043D\u044F\u043B\u0441\u044F \u0442\u0443\u0440\u0438\u0437\u043C\u043E\u043C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u043D\u0430\u0448\u0443 \u0422\u0410\u041A\u0422\u043E\u0432\u0441\u043A\u0443\u044E \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044E \u043D\u0435\u0432\u0437\u0438\u0440\u0430\u044F \u043D\u0430 \u0432\u0440\u0430\u0447\u0435\u0439. \u041A\u0430\u043A \u0438 \u0432\u0441\u0435 \u043C\u044B, \u0443\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F \u043E\u043D \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439.\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u0421\u0445\u043E\u0434\u0438\u043B\u0438 \u043C\u044B \u0441 \u0412\u043E\u043B\u043E\u0434\u0435\u0439 \u0432 \u043E\u0434\u0438\u043D \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u043F\u043E \u0422\u043E\u043C\u0441\u043A\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0437\u0434\u0435\u043D\u0439 \u043E\u0441\u0435\u043D\u044C\u044E 1983. \u041F\u043E\u0445\u043E\u0434 \u0432\u0435\u043B\u0430 \u043C\u043E\u044F \u0436\u0435\u043D\u0430 \u0412\u0438\u043A\u0430. \u0411\u044B\u043B\u043E \u043D\u0430\u0441 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435 4 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u0412\u0438\u043A\u0430 \u0431\u044B\u043B\u0430 \u0022\u0443\u043C, \u0447\u0435\u0441\u0442\u044C \u0438 \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0422\u0410\u041A\u0422\u0430\u0022 \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F. \u041F\u0440\u043E \u0443\u043C \u044F \u043C\u043E\u0436\u0435\u0442 \u0438 \u0437\u0430\u0433\u043D\u0443\u043B (\u0448\u0443\u0447\u0443!), \u043D\u043E \u0447\u0435\u0441\u0442\u044C \u0438 \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0443 \u043D\u0435\u0435 \u0431\u044B\u043B\u0438 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043D\u0435\u0441\u0433\u0438\u0431\u0430\u0435\u043C\u044B\u0435. \u0412 \u0442\u043E\u0442 \u043F\u043E\u0445\u043E\u0434 \u0412\u043E\u043B\u043E\u0434\u044F \u0438 \u044F \u0442\u0430\u0439\u043A\u043E\u043C \u0432\u0437\u044F\u043B\u0438 \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0432\u0438\u043D\u0430. \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u0439-\u0436\u0435 \u043D\u043E\u0447\u0435\u0432\u043A\u0435 \u0412\u0438\u043A\u0430 \u0435\u0435 \u043A\u0430\u043A-\u0442\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430 \u0438 \u0437\u0430\u043A\u0438\u043D\u0443\u043B\u0430 \u0432 \u0441\u043D\u0435\u0433 \u0432 \u043F\u043E\u043B\u04