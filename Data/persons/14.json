    {
      "Title": "\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u041F\u0443\u0441\u0442\u043E\u0432\u043E\u0439\u0442 \u041D.\u042F.",
      "Subtitle": "\u041F\u0443\u0441\u0442\u043E\u0432\u043E\u0439\u0442 (\u0422\u0440\u0435\u043D\u0438\u043D\u0430) \u041D\u0430\u0434\u0435\u0436\u0434\u0430 \u042F\u043A\u043E\u0432\u043B\u0435\u0432\u043D\u0430",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u041C\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u0435\u0441\u0435\u043D\u043D\u0438\u0439 \u0441\u043B\u0435\u0442 1967\u0433. \u0423\u0439\u043C\u0430 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0439. \u041D\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0435 \u0026laquo;\u043C\u043E\u043D\u0441\u0442\u0440\u044B\u0026raquo;, \u043B\u0435\u0433\u0435\u043D\u0434\u044B \u0442\u0443\u0440\u0438\u0437\u043C\u0430-\u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0437\u043C\u0430 \u0410.\u041C. \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u043D\u0438\u043A\u043E\u0432, \u041D.\u041F. \u0414\u0435\u043D\u0438\u0441\u043E\u0432 \u0432\u044B\u0448\u043B\u0438 \u0432 \u0431\u0435\u043B\u044B\u0445 \u0440\u0443\u0431\u0430\u0448\u043A\u0430\u0445 \u0026ndash; \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u044E\u0449\u0430\u044F! \u0421 \u043A\u0430\u043A\u0438\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C \u043C\u044B \u043A \u043D\u0438\u043C \u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C!\u003C/p\u003E",
