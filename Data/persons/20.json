u0433 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 3 \u043A.\u0441. \u043F\u043E \u0413\u043E\u0440\u043D\u043E\u043C\u0443 \u0410\u043B\u0442\u0430\u044E","IsActive":true,"Data":"http://takt.tomsk.ru/db/trav2.look?tid=1482","Category":2,"AttachmentType":3,"Order":8,"CreatedAt":"2012-08-13T17:21:35","PersonId":0,"Person":null,"Id":0},{"Title":"1968\u0433 \u043B\u044B\u0436\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 3 \u043A.\u0441. \u043F\u043E \u0421\u0435\u0432\u0435\u0440\u043E-\u0427\u0443\u0439\u0441\u043A\u043E\u043C\u0443 \u0445\u0440\u0435\u0431\u0442","Subtitle":"1968\u0433 \u043B\u044B\u0436\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 3 \u043A.\u0441. \u043F\u043E \u0421\u0435\u0432\u0435\u0440\u043E-\u0427\u0443\u0439\u0441\u043A\u043E\u043C\u0443 \u0445\u0440\u0435\u0431\u0442\u0443 \u0413\u043E\u0440\u043D\u043E\u0433\u043E \u0410\u043B\u0442\u0430\u044F","IsActive":true,"Data":"http://takt.tomsk.ru/db/trav2.look?tid=1484","Category":2,"AttachmentType":3,"Order":9,"CreatedAt":"2012-08-13T17:22:39","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u041D\u0435\u0447\u0435\u043F\u0443\u0440\u0435\u043D\u043A\u043E \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440","Subtitle":"\u041D\u0435\u0447\u0435\u043F\u0443\u0440\u0435\u043D\u043A\u043E \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440","IsActive":true,"Data":"\u003Cp\u003E1. \u0417\u0435\u0440\u043D\u043E\u0432 \u0410.\u0410. \u0026nbsp;\u0438 \u041F\u0438\u0432\u043D\u043E\u0439 \u0441\u043B\u0435\u0442.\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u0412 \u0441\u0435\u043A\u0446\u0438\u044E \u0442\u0443\u0440\u0438\u0437\u043C\u0430 \u0438 \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0437\u043C\u0430 \u043C\u0435\u043D\u044F \u0026laquo;\u0432\u0442\u044F\u043D\u0443\u043B\u0026raquo; \u041D\u0438\u043A\u0438\u0442\u0438\u043D \u0432 \u043A\u0440\u043E\u0441\u0441\u044B \u0438 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0432 1965\u0433. (\u0413\u0440\u0430\u043C\u043E\u0442\u0430 \u0437\u0430 2-\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0432 \u043A\u0440\u043E\u0441\u0441\u0435 \u043E\u0442 17 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 65\u0433.). \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u044F \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u043B \u0432 \u0440\u0430\u0431\u043E\u0442\u0435 \u0441\u0435\u043A\u0446\u0438\u0438, \u043D\u043E \u043E\u0447\u0435\u043D\u044C \u0441\u0431\u043B\u0438\u0437\u0438\u043B\u0441\u044F \u0441 \u0417\u0435\u0440\u043D\u043E\u0432\u044B\u043C \u0438 \u041C\u0430\u0449\u0435\u043D\u043A\u043E.\u0026nbsp;\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0431\u044B\u043B \u043A\u0443\u043C\u0438\u0440\u043E\u043C - \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043D , \u0441\u043F\u043E\u043A\u043E\u0435\u043D, \u0440\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u0435\u043B\u0435\u043D, \u0433\u043E\u0442\u043E\u0432 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043C\u043E\u0447\u044C \u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0435\u0433\u043E \u043E\u0431\u0432\u043E\u0440\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0439 \u0441\u043C\u0435\u0445 (\u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0026nbsp;\u0443 \u043C\u0435\u043D\u044F \u0432 \u0443\u0448\u0430\u0445 \u0441 \u043C\u0430\u044F 1967\u0433. \u0434.\u0422\u0440\u0443\u0431\u0430\u0447\u0435\u0432\u043E).\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0430\u043F\u0440\u0435\u043B\u044F \u043C\u0435\u043D\u044F \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0417\u0435\u0440\u043D\u043E\u0432 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C \u0435\u043C\u0443 \u0432 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0435 \u043F\u043E\u043B\u044F\u043D\u044B \u043A \u041C\u0430\u0439\u0441\u043A\u043E\u043C\u0443 \u0441\u043B\u0435\u0442\u0443 \u0432 67\u0433. \u0434.\u0422\u0440\u0443\u0431\u0430\u0447\u0435\u0432\u043E \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043C\u0435\u043D\u044F \u0432 \u0441\u043F\u0430\u0441\u043E\u0442\u0440\u044F\u0434. \u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F. \u0414\u043E \u0441\u043B\u0435\u0442\u0430 \u043C\u044B \u0432\u044B\u0435\u0437\u0436\u0430\u043B\u0438 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430. \u041D\u0430 \u043F\u043E\u043B\u044F\u043D\u0435 \u0441\u043D\u0435\u0433 \u043B\u0435\u0436\u0430\u043B, \u0430 \u0432\u044B\u0431\u043E\u0440\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E. \u0412\u043E\u0440\u043E\u0448\u0438\u043B\u0438, \u0443\u0431\u0438\u0440\u0430\u043B\u0438 \u043F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F, \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0442\u0440\u0430\u0441\u0441\u0443. \u0421\u043B\u0435\u0442 \u043F\u0440\u043E\u0448\u0435\u043B \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0438 \u043E\u043D \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0422\u0410\u041A\u0422\u0430. \u0410 \u0434\u043B\u044F \u0417\u0435\u0440\u043D\u043E\u0432\u0430 \u0435\u0449\u0435 \u043D\u0435\u0442. \u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043C\u0430\u044F, \u0432 \u043F\u044F\u0442\u043D\u0438\u0446\u0443, \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043E\u043D \u043C\u0435\u043D\u044F \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0435\u0445\u0430\u0442\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0430 \u0441\u043B\u0435\u0442\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0438 \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C \u0441\u0442\u0435\u043A\u043B\u043E \u0438 \u043C\u0443\u0441\u043E\u0440. \u042D\u0442\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u043D\u0438\u043A\u043E\u0432\u0430, \u0442\u0430\u043A \u043A\u0430\u043A \u043A\u0442\u043E\u0026ndash;\u0442\u043E \u0438\u0437 \u0433\u043E\u0441\u0442\u0435\u0439 (\u043D\u0430 \u0441\u043B\u0435\u0442\u0435 \u0431\u044B\u043B\u0438 \u0433\u043E\u0441\u0442\u0438 \u0438 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C \u0026nbsp;\u0433\u043E\u0441\u0442\u0435\u0432\u0430\u044F \u043F\u0430\u043B\u0430\u0442\u043A\u0430) \u043D\u043E\u0447\u044C\u044E \u043F\u043E\u0440\u0430\u043D\u0438\u043B \u043D\u043E\u0433\u0443 \u043E \u0441\u0442\u0435\u043A\u043B\u043E. \u041E\u043D \u0431\u044B\u043B \u043E\u0447\u0435\u043D\u044C \u0433\u043D\u0435\u0432\u0435\u043D. \u0423\u0437\u043D\u0430\u043B \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u043D\u0438\u043A\u043E\u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C. \u0022\u0410 \u0435\u0441\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0435 \u043D\u043E\u0433\u0438 \u043F\u043E\u0440\u0435\u0436\u0443\u0442 \u043B\u0435\u0442\u043E\u043C? \u0026nbsp;\u0421\u043A\u0430\u043D\u0434\u0430\u043B! \u041A\u0430\u043A \u043D\u0430\u0447\u0441\u043F\u0430\u0441\u0430, \u0442\u044B \u0438 \u0417\u0435\u0440\u043D\u043E\u0432 \u0432 \u043E\u0442\u0432\u0435\u0442\u0435.\u0022...\u003C/p\u003E\r\n\u003Cp\u003E\u042F \u0433\u043E\u0442\u043E\u0432 \u0438 \u0443\u0442\u0440\u043E\u043C \u0432\u044B\u0435\u0445\u0430\u043B\u0438. \u041F\u043E\u0433\u043E\u0434\u0430 \u0431\u044B\u043B\u0430 \u0443\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0438 \u043C\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043C\u043D\u043E\u0433\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0438. \u041A\u0430\u043A \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0440\u0430\u0437 \u043D\u0435 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C \u0438 \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0442\u0430\u043B\u0430\u043D\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430 \u0026nbsp;\u0438 \u0437\u0430\u0431\u043E\u0442\u0443 \u043E \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u0435 \u043A\u043B\u0443\u0431\u0430 \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u043D\u0438\u043A\u043E\u0432\u044B\u043C!\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u043C\u044B \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u0443\u0436\u0438\u043D, \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u043F\u043E \u043F\u044F\u0442\u044C \u0433\u0440\u0430\u043C\u043C \u043D\u0430 \u0433\u0440\u0443\u0434\u044C \u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0431\u0443\u0434\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0442\u0435\u043C\u0443 \u043E \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0438 \u0432 \u0441\u0435\u043A\u0446\u0438\u044E \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0445 \u043D\u0430 \u0433\u043E\u043B\u043E\u043C \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u0435 \u0431\u0435\u0437 \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.\u003C/p\u003E\r\n\u003Cp\u003E\u0418 \u0432\u0434\u0440\u0443\u0433 \u0417\u0435\u0440\u043D\u043E\u0432 \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F \u0441\u0432\u043E\u0438\u043C \u0441\u043C\u0435\u0445\u043E\u043C! \u0422\u044B \u0447\u0442\u043E? \u0410 \u0435\u0441\u043B\u0438 \u0441\u044E\u0434\u0430 \u0431\u043E\u0447\u043A\u0443 \u043F\u0438\u0432\u0430? \u041D\u0430\u0440\u043E\u0434 \u0433\u0443\u0440\u044C\u0431\u043E\u0439 \u043F\u043E\u0439\u0434\u0435\u0442! \u0418 \u043F\u043E\u0448\u043B\u043E, \u0438 \u043F\u043E\u0435\u0445\u0430\u043B\u043E! \u041E\u0441\u0435\u043D\u044C\u044E \u0432\u0441\u0435 \u043F\u0440\u0438\u0435\u0434\u0443\u0442 \u043D\u0430 \u0443\u0447\u0435\u0431\u0443, \u0441 \u043F\u043E\u0445\u043E\u0434\u043E\u0432, \u0441 \u0430\u043B\u044C\u043F\u043B\u0430\u0433\u0435\u0440\u0435\u0439, \u043F\u043E\u043A\u0430 \u0440\u0430\u0441\u043A\u0430\u0447\u043A\u0430 \u0432 \u0443\u0447\u0435\u0431\u0435 \u0438 \u0442.\u0434.\u0438 \u0442.\u043F. \u0420\u0435\u0448\u0438\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0437\u043A\u0438\u0439 \u043A\u0440\u0443\u0433. \u0421\u0435\u0441\u0441\u0438\u044F , \u043B\u0435\u0442\u043E, \u043E\u0441\u0435\u043D\u044C , \u0443\u0447\u0435\u0431\u0430 \u0438 \u0433\u0434\u0435-\u0442\u043E \u043A \u043D\u043E\u044F\u0431\u0440\u044E 67\u0433. \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0441\u044F \u0441 \u0417\u0435\u0440\u043D\u043E\u0432\u044B\u043C \u0438 \u043E\u043D \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u043B \u043C\u043D\u0435 \u043E \u0431\u043E\u0447\u043A\u0435 \u043F\u0438\u0432\u0430. \u0421 \u041C\u0430\u0449\u0435\u043D\u043A\u043E \u043E\u043D\u0438 \u0445\u043E\u0434\u0438\u043B\u0438 \u043D\u0430 \u043F\u043E\u043B\u044F\u043D\u0443 \u0434.\u0422\u0440\u0443\u0431\u0430\u0447\u0435\u0432\u043E, \u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044B, \u043F\u043E\u0434\u044C\u0435\u0437\u0434\u044B \u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u043F\u0440\u043E\u0435\u043A\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C. \u041C\u043D\u0435 \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0432 68\u0433. \u0431\u044B\u0442\u044C \u043D\u0430\u0447\u0441\u043F\u0430\u0441\u043E\u043C, \u0026nbsp;\u0435\u0441\u0442\u044C \u043F\u043E\u043B\u044F\u043D\u0430 \u0441\u043B\u0435\u0442\u0430, \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u041C\u0430\u0439\u0441\u043A\u0438\u0439 \u0441\u043B\u0435\u0442. \u0410 \u0026nbsp;\u0432 \u0422\u0440\u0443\u0431\u0430\u0447\u0435\u0432\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u041F\u0438\u0432\u043D\u043E\u0439 \u0441\u043B\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u043D\u0438\u043A\u043E\u0432 \u0431\u044B\u043B \u0431\u0435\u0437 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u0439. \u041A\u0442\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u043B, \u043A\u0442\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u043B \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443 \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u041F\u0438\u0432\u043D\u043E\u0433\u043E \u0026ndash; \u043D\u0435 \u0437\u043D\u0430\u044E.\u003C/p\u003E\r\n\u003Cp\u003E\u0421\u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0430 \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0435 \u0431\u043E\u0447\u043A\u0438 \u0438\u043C\u0435\u043B \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435. \u0412\u0435\u0441\u043D\u043E\u0439 68\u0433. \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u0432 \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0438 \u043F\u043E\u0448\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C. \u0421\u043B\u0443\u0447\u0430\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F \u043F\u0440\u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435 \u0441 \u0413\u0430\u0435\u0432\u044B\u043C \u043D\u0430 \u044D\u0442\u0443 \u0442\u0435\u043C\u0443. \u041E\u043D \u0442\u0432\u0435\u0440\u0434\u043E \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0431\u0435\u0440\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0441\u0435\u043D\u044C\u044E \u043D\u0430 \u043C\u0435\u0441\u0442\u043E \u0431\u043E\u0447\u043A\u0443 \u043F\u0438\u0432\u0430. \u041E\u0441\u0435\u043D\u044C\u044E \u0443\u0436\u0435 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C \u0413\u0430\u0435\u0432, \u0421\u0435\u043B\u0438\u043D, \u0420\u043E\u0434\u0438\u043E\u043D\u043E\u0432\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E2. \u0417\u0435\u0440\u043D\u043E\u0432 \u0438 \u0026nbsp;\u041C\u0430\u0439\u0441\u043A\u0438\u0439 \u0441\u043B\u0435\u0442 68\u0433. \u0434.\u0410\u0440\u043A\u0430\u0448\u0435\u0432\u043E\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E\u043B\u044F\u043D\u0443 \u0434\u043B\u044F \u0441\u043B\u0435\u0442\u0430 68\u0433. \u043F\u0440\u0438\u043C\u0435\u0442\u0438\u043B \u0417\u0435\u0440\u043D\u043E\u0432 \u0438 \u043A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u043B\u0435\u0442, \u0442\u043E \u0432\u044B\u0431\u043E\u0440 \u043E\u0434\u0438\u043D \u0026ndash; \u0434.\u0410\u0440\u043A\u0430\u0448\u0435\u0432\u043E. \u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u044B\u0445\u043E\u0434 \u043C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0434\u0435\u043A\u0430\u0431\u0440\u044F 67\u0433. \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0439\u043E\u043D \u043D\u0430 \u043B\u044B\u0436\u0430\u0445. \u041E\u043A\u0440\u0443\u0433\u0430 \u043D\u0430\u043C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C. \u0412\u0442\u043E\u0440\u043E\u0439 \u0432\u044B\u0445\u043E\u0434 \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0432 \u043A\u043E\u043D\u0446\u0435 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 68\u0433. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435 \u0417\u0435\u0440\u043D\u043E\u0432 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043B \u0441 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0438 \u043C\u044B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E \u043D\u0430\u0447\u0430\u043B\u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0443\u0431\u0431\u043E\u0442\u0443 \u0438 \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u0435 \u0441 \u043D\u043E\u0447\u0435\u0432\u043A\u0430\u043C\u0438 \u0026nbsp;\u0434\u0435\u0442\u0430\u043B\u044C\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043F\u043E\u043B\u044F\u043D\u0443 \u0441 \u0430\u043F\u0440\u0435\u043B\u044F. \u041C\u0435\u0441\u0442\u043D\u043E\u0435 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0443\u0436\u0435 \u0437\u043D\u0430\u043B\u043E, \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0435\u0442, \u043D\u0443\u0436\u043D\u044B \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B. \u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u0442\u0430\u043A\u0436\u0435 \u0026nbsp;\u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0430\u0441 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432 \u0438\u043C\u0435\u043B\u0441\u044F. \u0414\u043E\u0440\u043E\u0433\u0438, \u0440\u0430\u0437\u043B\u0438\u0432 \u0440\u0435\u043A\u0438 \u0438 \u043F\u0440\u043E\u0447\u0435\u0435, \u0432\u0441\u0435 \u044D\u0442\u043E \u0417\u0435\u0440\u043D\u043E\u0432 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u043E \u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B. \u041E\u043F\u044F\u0442\u044C \u0026nbsp;\u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0432\u043E\u0440\u043E\u0448\u0438\u043B\u0438 \u0441\u043D\u0435\u0433 , \u0443\u0431\u0438\u0440\u0430\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0430\u0445 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u0430\u043B\u0430\u0442\u043E\u043A, \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u0442\u0440\u0430\u0441\u0441\u0443. \u0410 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0026nbsp;\u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u043E \u0431\u043E\u0447\u043A\u0435 \u043F\u0438\u0432\u0430 \u043D\u0430 \u043F\u043E\u043B\u044F\u043D\u0443 \u0432 \u0434.\u0422\u0440\u0443\u0431\u0430\u0447\u0435\u0432\u043E! \u041C\u0430\u0449\u0435\u043D\u043A\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043F\u0430\u043B\u0430\u0442\u043A\u0438 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0442\u043E \u0433\u0434\u0435 \u0445\u043E\u0447\u0435\u0442, \u0431\u043E\u0447\u043A\u0443 \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C \u0438 \u043F\u043E\u0441\u043B\u0435 \u043E\u0442\u0447\u0435\u0442\u043E\u0432 \u0432\u044B\u043A\u0430\u0442\u0438\u0442\u044C/ \u0418 \u0432\u043E\u0442 \u043D\u0430 \u0442\u0430\u043A\u043E\u043C \u043F\u043E\u0434\u044C\u0435\u043C\u0435 \u0448\u043B\u0430 \u043A\u0430\u043A-\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u0438 \u043F\u0440\u043E\u0448\u0435\u043B \u043D\u0430 \u0423\u0440\u0430 \u0441\u043B\u0435\u0442 68\u0433\u043E\u0434\u0430. \u0026nbsp;\u0412 \u044D\u0442\u043E\u043C \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0437\u0430\u0441\u043B\u0443\u0433\u0430 \u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447\u0430 \u0417\u0435\u0440\u043D\u043E\u0432\u0430! \u041C\u043E\u0435 \u043C\u043D\u0435\u043D\u0438\u0435 - \u044D\u0442\u043E \u0417\u0435\u0440\u043D\u043E\u0432 \u0438 \u041C\u0430\u0449\u0435\u043D\u043A\u043E \u0026ndash; \u0448\u0435\u0440\u043F\u044B \u0422\u0410\u041A\u0422\u0430 \u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u043C \u043F\u0443\u0442\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F, \u0437\u0430\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u043B\u043E\u0434\u044B\u0445, \u043F\u043E\u043C\u043E\u0449\u044C, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430, \u044E\u043C\u043E\u0440, \u043F\u043E\u0445\u043E\u0434\u044B, \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u0442.\u0434.\u0026nbsp;\u003C/p\u003E","Category":1,"AttachmentType":5,"Order":10,"CreatedAt":"2012-08-13T17:38:34","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u041D\u0435\u043A\u0440\u0430\u0441\u043E\u0432 \u0022\u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447 \u0438 \u0412\u043E\u043B\u044C\u043A\u0430\u0022","Subtitle":"\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u041D\u0435\u043A\u0440\u0430\u0441\u043E\u0432 \u0022\u0421\u0430\u043D \u0421\u0430\u043D\u044B\u0447 \u0438 \u0412\u043E\u043B\u044C\u043A\u0430\u0022","IsActive":true,"Data":"20120814004513.doc","Category":1,"AttachmentType":6,"Order":11,"CreatedAt":"2012-08-13T17:44:16","PersonId":0,"Person":null,"Id":0},{"Title":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435.\u041D\u0430\u0434\u0435\u0436\u0434\u0430 \u0417\u0435\u0440\u043D\u043E\u0432\u0430","Subtitle":"\u041D\u0430\u0434\u0435\u0436\u0434\u0430 \u0417\u0435\u0440\u043D\u043E\u0432\u0430","IsActive":true,"Data":"\u003Cp\u003E\u0436\u0438\u0437\u043D\u044C \u0421\u0430\u0448\u0438 - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0438\u0437\u043D\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u043B. \u0414\u0440\u0443\u0437\u044C\u044F - \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u043E \u0438 \u043E\u043D \u0443\u043C\u0435\u043B \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u043E\u0431\u0449\u0438\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0447\u0438\u0442\u0430\u043B \u0435\u0433\u043E \u0441\u0432\u043E\u0438\u043C \u0026nbsp;\u043B\u0443\u0447\u0448\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C, \u041E\u043D \u043D\u0430\u0443\u0447\u0438\u043B \u0434\u0435\u0442\u0435\u0439, \u0434\u0440\u0443\u0437\u0435\u0439, \u043C\u0435\u043D\u044F \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u0436\u0438\u0437\u043D\u0438 \u0434\u0440\u0443\u0436\u0431\u0443, \u043E\u0431\u0449\u0435\u043D\u0438\u0435. \u0412\u0441\u0435 \u044D\u0442\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0441\u043B\u043E\u0432\u0430, \u043D\u043E \u0432\u0441\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E.\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u0412 \u0418\u042F\u0424\u0435 (\u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u044F\u0434\u0435\u0440\u043D\u043E\u0439 \u0444\u0438\u0437\u0438\u043A\u0438), \u0431\u0443\u0434\u0443\u0447\u0438 \u0421\u041D\u0421, \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u043B\u0430\u0431-\u0440\u0438\u0438 \u041C\u0430\u0441\u0441\u043F\u0435\u043A\u0442\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0438, \u0441\u0430\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043C\u0430\u0441\u0441\u043F\u0435\u043A\u0442\u0440\u043E\u0433\u0430\u0444, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E-\u043C\u043E\u0435\u043C\u0443 \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0433\u043E\u0434\u044B \u0442\u0430\u043C \u0436\u0435 \u0431\u044B\u043B \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u043D\u0438\u0437\u043A\u043E\u0444\u043E\u043D\u043E\u0432\u044B\u0445 \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u0439, \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432 \u0431\u044B\u043B \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0026nbsp;(38 \u0447\u0435\u043B.) - \u043E\u043D\u0438 \u0432\u0441\u0435 \u043E\u0431\u043E\u0436\u0430\u043B\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430. \u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u044E\u0431\u0438\u043B \u0436\u0435\u043D\u0449\u0438\u043D, \u0441\u0447\u0438\u0442\u0430\u043B\u0441\u044F \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0438\u0445 \u0022\u043A\u0430\u043F\u0440\u0438\u0437\u0430\u043C\u0438\u0022 \u0432\u043E \u0432\u0441\u0435\u043C \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u043F\u043E\u043C\u043E\u0447\u044C, \u0432\u0441\u0435\u0445 \u043F\u043E\u043D\u0438\u043C\u0430\u043B, \u044F \u0441\u0447\u0438\u0442\u0430\u044E, \u044D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u0443\u0436\u0447\u0438\u043D\u044B!\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0412 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043A\u0435 \u043C\u0435\u0436\u0434\u0443 \u043F\u0435\u0440\u0438\u043E\u0434\u0430\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0418\u042F\u0424\u0435 \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0433\u0435\u043E\u043B\u043E\u0433\u043E\u043F\u043E\u0438\u0441\u043A\u043E\u0432\u043E\u0439 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438, \u0437\u0430\u0442\u0435\u043C \u0432 \u0413\u0438\u0434\u0440\u043E\u043C\u0435\u0442\u0446\u0435\u043D\u0442\u0440\u0435 \u0413\u043B\u0430\u0432\u043D\u044B\u043C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0439. \u0412 \u0433\u043E\u0434\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0442\u0440\u0443\u0434\u043D\u043E \u0436\u0438\u0442\u044C \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430\u043C, \u043E\u043D \u043F\u043E\u0434\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B, \u0433\u0434\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0433, \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u043E\u043C \u0432 \u043C\u043E\u0440\u0433\u0435 \u043C\u0435\u0434\u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430, \u043D\u043E\u0447\u043D\u044B\u043C \u0432\u0430\u0445\u0442\u0435\u0440\u043E\u043C, \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u043C \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435 \u041C\u0438\u0445\u0430\u0439\u043B\u043E\u0432\u0430 \u0438. \u0442. \u0434.\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp; \u0026nbsp; \u0412 \u0441\u0435\u043C\u044C\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u043C \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0441\u043F\u043E\u0440\u0442\u043E\u043C \u0441 \u0434\u0435\u0442\u044C\u043C\u0438, \u043F\u043E\u0445\u043E\u0434\u044B \u0432 \u0433\u043E\u0440\u044B, \u043A\u0430\u0442\u0430\u043D\u0438\u0435 \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0445 \u043B\u044B\u0436\u0430\u0445. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0435\u0433\u043E \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u043C\u0443 \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u0443 \u0432\u0441\u044F \u043D\u0430\u0448\u0430 \u0441\u0435\u043C\u044C\u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043A\u0430\u0442\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0445 \u043B\u044B\u0436\u0430\u0445, \u0438 \u0434\u0435\u0442\u0438, \u0438 \u0432\u043D\u0443\u043A\u0438 \u0438 \u044F. \u0412\u0441\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u0431\u044B\u043B\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u043C\u0438 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0438\u043B\u0438 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0430. \u0410 \u043A\u043E\u0433\u0434\u0430 \u0443 \u043D\u0430\u0441 \u0434\u043E\u043C\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C \u0434\u0440\u0443\u0437\u044C\u044F, \u0432\u0441\u0435 \u043E\u0431\u043E\u0436\u0430\u043B\u0438 \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u043A\u0430\u043A \u043E\u043D \u0438\u0433\u0440\u0430\u043B \u043D\u0430 \u0433\u0438\u0442\u0430\u0440\u0435 \u0438 \u043F\u0435\u043B, \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u043C\u043D\u043E\u0439, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043B\u043E\u0432\u0430 \u043F\u043E\u043C\u043D\u0438\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u044F. \u0026nbsp;\u0418 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0438\u0433\u0440\u0430\u043B, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B \u041A\u043E\u043B\u044F \u0412\u0438\u043D\u043E\u043A\u0443\u0440\u043E\u0432.. \u0421\u0447\u0438\u0442\u0430\u043B \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u043C.\u0026nbsp;\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E\u0441\u043B\u0435 \u0441\u0432\u0430\u0434\u044C\u0431\u044B, \u043F\u043E\u043C\u043D\u044E, \u0421\u0430\u0448\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u043D\u0430\u0448\u0438 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438: \u044F \u0431\u0443\u0434\u0443 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u043C \u0441\u0435\u043A\u0442\u043E\u0440\u043E\u043C, \u0430 \u0442\u044B - \u043A\u0443\u043B\u044C\u0442\u043C\u0430\u0441\u0441\u043E\u0432\u044B\u043C. \u0418 \u0442\u0430\u043A \u0431\u044B\u043B\u043E. \u0410 \u043B\u044E\u0431\u043E\u0432\u044C \u043A \u0433\u043E\u0440\u0430\u043C \u043E\u043D \u043F\u0440\u0438\u0432\u0438\u043B \u0438 \u0026nbsp;\u0434\u0435\u0442\u044F\u043C \u0026nbsp;\u0438 \u0438\u0445 \u0434\u0440\u0443\u0437\u044C\u044F\u043C.\u0026nbsp;\u003C/p\u003E","Category":1,"AttachmentType":5,"Order":12,"CreatedAt":"2012-09-07T04:58:29","PersonId":0,"Person":null,"Id":0}],"Id":20}