{
  "FirstName": "\u041E\u043B\u044C\u0433\u0430",
  "LastName": "\u041A\u0443\u0436\u0435\u043B\u0435\u0432\u0430",
  "MaidenName": "\u041F\u0440\u0430\u0445\u0442",
  "Patronymic": "\u0414\u0430\u0432\u044B\u0434\u043E\u0432\u043D\u0430",
  "Nickname": "",
  "Birthday": "1949-04-23T00:00:00Z",
  "DeathDay": "1993-06-07T00:00:00Z",
  "Biography": "\u003Cp\u003E\u041A\u0443\u0436\u0435\u043B\u0435\u0432\u0430 (\u041F\u0440\u0430\u0445\u0442) \u041E\u043B\u044C\u0433\u0430 \u0414\u0430\u0432\u044B\u0434\u043E\u0432\u043D\u0430 \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C 23 \u0430\u043F\u0440\u0435\u043B\u044F 1949 \u0433.\u0432 \u0433. \u0411\u0435\u043B\u043E\u0432\u043E \u041A\u0435\u043C\u0435\u0440\u043E\u0432\u0441\u043A\u043E\u0439 \u043E\u0431\u043B.\u0412 1966 \u0433. \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430 \u0411\u043E\u0447\u0430\u0442\u0441\u043A\u0443\u044E \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0448\u043A\u043E\u043B\u0443, \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u0432 \u0422\u0418\u0420\u0438\u042D\u0422 \u043D\u0430 \u041A\u0422\u0424. \u042D\u0442\u043E\u0439 \u0436\u0435 \u043E\u0441\u0435\u043D\u044C\u044E \u043F\u0440\u0438\u0448\u043B\u0430 \u0432 \u0422\u0410\u041A\u0422 \u0438 \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u0443\u0447\u0435\u0431\u044B \u0431\u044B\u043B\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u043E\u0439 \u0432\u0441\u0435\u0445 \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u043A\u043B\u0443\u0431\u0430. \u0412 1971 \u0433. \u0432\u044B\u0448\u043B\u0430 \u0437\u0430\u043C\u0443\u0436 \u0437\u0430 \u0421\u0435\u0440\u0433\u0435\u044F \u041A\u0443\u0436\u0435\u043B\u0435\u0432\u0430. \u0423 \u043D\u0438\u0445 \u0440\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0434\u0432\u043E\u0435 \u0441\u044B\u043D\u043E\u0432\u0435\u0439 \u041B\u0435\u043E\u043D\u0438\u0434 \u0438 \u0415\u0432\u0433\u0435\u043D\u0438\u0439.\u003C/p\u003E\r\n\u003Cp\u003E\u0423\u043C\u0435\u0440\u043B\u0430 07 \u0438\u044E\u043B\u044F 1993 \u0433.\u0026nbsp;\u003C/p\u003E\r\n\u003Cdiv\u003E\u0026nbsp;\u003C/div\u003E",
