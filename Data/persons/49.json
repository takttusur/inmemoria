Id":719,"PersonId":0,"Name":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435-\u041F\u043E\u043F\u043E\u0432\u044B","ResourceType":0,"Rubric":1,"Data":"\u003Cp\u003E\u0412 \u0422\u0410\u041A\u0422\u0435 \u0412\u043E\u043B\u043E\u0434\u044F \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u043E\u0434\u0438\u043D 1985-1986 \u0433\u043E\u0434 \u0438 \u043D\u0430 \u041A\u0422\u0424 \u0432\u0441\u0435\u043C \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0441\u044F \u0434\u043E\u0431\u0440\u044B\u043C \u0438 \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u042F \u0432\u0435\u0441\u043D\u043E\u0439 1986\u0433. \u0443\u0435\u0445\u0430\u043B \u0438\u0437 \u0422\u043E\u043C\u0441\u043A\u0430 \u0438, \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0437\u0430 \u0437\u0438\u043C\u0443 \u043C\u044B \u0441 \u043D\u0438\u043C \u0443\u0441\u043F\u0435\u043B\u0438 \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u0442\u044C\u0441\u044F. \u0418 \u043D\u0430 \u043D\u0430\u0448\u0443 \u0441\u0432\u0430\u0434\u044C\u0431\u0443 \u0441\u043E \u0421\u0432\u0435\u0442\u043B\u0430\u043D\u043E\u0439 \u0432 \u043F\u043E\u0441.\u041A\u043E\u043B\u044C\u0446\u043E\u0432\u043E \u043F\u043E\u0434 \u041D\u043E\u0432\u043E\u0441\u0438\u0431\u0438\u0440\u0441\u043A\u043E\u043C \u0432 \u043C\u0430\u0435 1986 \u0412\u043E\u043B\u043E\u0434\u044F \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0432 \u0447\u0438\u0441\u043B\u0435 \u043D\u0430\u0448\u0438\u0445 \u0431\u043B\u0438\u0437\u043A\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439. \u0414\u0430\u043B\u0435\u0435 \u0441 1987 \u0433\u043E\u0434\u0430 \u0435\u0433\u043E \u0443\u0447\u0451\u0431\u0443 \u0432 \u0422\u0418\u0410\u0421\u0423\u0420\u0435 \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u0430 \u0441\u043B\u0443\u0436\u0431\u0430 \u0432 \u0430\u0440\u043C\u0438\u0438. \u0421\u043B\u0443\u0436\u0438\u043B \u0432 \u0434\u0438\u0432\u0438\u0437\u0438\u0438 \u0412\u0414\u0412, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0439\u0441\u044F \u0432 \u041A\u0438\u0440\u043E\u0432\u043E\u0431\u0430\u0434\u0435 \u0432 \u0410\u0437\u0435\u0440\u0431\u0430\u0439\u0434\u0436\u0430\u043D\u0435. \u041C\u044B \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0438\u0441\u044C \u0441 \u043D\u0438\u043C. \u0421\u043B\u0443\u0436\u0438\u043B \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E \u0431\u0435\u0437 \u0436\u0430\u043B\u043E\u0431, \u0430 \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E \u043C\u0435\u0436\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430! \u041F\u043E\u0441\u043B\u0435 \u0430\u0440\u043C\u0438\u0438, \u0432 1989 \u0433., \u0412\u043E\u043B\u043E\u0434\u044F \u0436\u0435\u043D\u0438\u043B\u0441\u044F \u043D\u0430 \u042E\u043B\u0435 \u0438 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435 \u0432 \u0422\u043E\u043C\u0441\u043A \u043C\u043E\u043B\u043E\u0434\u043E\u0436\u0451\u043D\u044B \u0437\u0430\u0435\u0445\u0430\u043B\u0438 \u043A \u043D\u0430\u043C \u0438 \u0412\u043E\u0432\u0430 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B \u043D\u0430\u0441 \u0441 \u0436\u0435\u043D\u043E\u0439. \u0412\u0440\u043E\u0434\u0435 \u0432\u0441\u0451 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u043E\u0441\u044C \u0443 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u0435\u043C\u044C\u0438 \u0445\u043E\u0440\u043E\u0448\u043E, \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0441\u044B\u043D \u0438 \u0442\u0443\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0433\u0438\u0431\u0435\u043B\u044C...\u003C/p\u003E","Position":2,"CreateTime":"0001-01-01T00:00:00","Comment":"\u0410\u043D\u043