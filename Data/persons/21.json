    {
      "Title": "\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u0432 \u0411\u043E\u0440\u0442\u0436\u0443\u0440\u043D\u0430\u043B\u0435 \u0422\u0410\u041A\u0422-4",
      "Subtitle": "\u0413\u0443\u0441\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u0432 \u041C\u0438\u0448\u0430",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u041C\u043E\u0433 \u0435\u0449\u0435 \u0446\u0435\u043D\u0438\u0442\u044C\u003Cbr /\u003E\u0423\u043B\u044B\u0431\u0430\u0442\u044C\u0441\u044F, \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0438\u0440\u003Cbr /\u003E\u041A\u043E\u0433\u043E-\u0442\u043E \u043F\u043E\u043B\u044E\u0431\u0438\u0442\u044C\u003Cbr /\u003E\u0421 \u043D\u0430\u043C\u0438 \u0420\u044F\u0434\u043E\u043C \u0431\u044B\u0442\u044C\u003Cbr /\u003E\u0418 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u003Cbr /\u003E\u0418 \u0431\u044B\u0442\u044C \u0432\u0435\u0437\u0434\u0435 \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u003Cbr /\u003E\u0417\u043B\u043E\u0441\u0442\u044C \u0441\u044A\u0435\u0434\u0430\u0435\u0442, \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0438..\u003Cbr /\u003E\u0410\u043D\u0434\u0440\u0435\u0439, \u043C\u0438\u0440 \u0437\u0430\u0441\u0442\u044B\u043B \u0431\u0435\u0437 \u0442\u0435\u0431\u044F \u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u043B\u0435\u0437\u0430\u043C \u0442\u0435\u0441\u043D\u043E\u003C/p\u003E",
