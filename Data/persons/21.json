\u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0431\u044B\u043B\u043E, \u0438\u043B\u0438 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0431\u044B, \u043D\u043E \u043F\u0438\u0441\u0430\u0442\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 - \u0442\u0440\u0443\u0434\u043D\u043E, \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\u003Cbr /\u003E\u041D\u0435\u0442 \u0441\u043B\u043E\u0432, \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u043C\u0435\u043D\u044F, \u043D\u043E \u0438 \u0443 \u043C\u043D\u043E\u0433\u0438\u0445 \u0438\u0437 \u043D\u0430\u0441. \u041C\u043D\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u0432 \u043D\u0430\u0448\u0438\u0445 \u0441\u0435\u0440\u0434\u0446\u0430\u0445 \u0437\u0430\u043D\u0438\u043C\u0430\u043B \u0410\u043D\u0434\u0440\u0435\u0439, \u043A\u043E \u043C\u043D\u043E\u0433\u0438\u043C \u043B\u044E\u0434\u044F\u043C \u0437\u0430 \u043E\u0447\u0435\u043D\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0441\u0440\u043E\u043A \u0443\u0441\u043F\u0435\u043B \u043E\u043D \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F. \u041D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0438 \u0432\u0430\u0436\u043D\u043E\u0435, \u0447\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435. \u0412\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043D\u0438\u0435, \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u043F\u043E\u043C\u043E\u0449\u044C (\u0443\u0447\u0430\u0441\u0442\u0438\u0435), \u0443\u043B\u044B\u0431\u043A\u0430 - \u0442\u0430\u043A\u0438\u043C \u043C\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043C \u043D\u0430\u0448\u0435\u0433\u043E \u0443\u0448\u0435\u0434\u0448\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430.\u003Cbr /\u003E\u041C\u043D\u043E\u0433\u0438\u0435 \u043F\u043B\u0430\u0447\u0443\u0442. \u0422\u044F\u0436\u0435\u043B\u043E - \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u041D\u043E \u0441\u0430\u043C\u0430 \u043F\u043B\u0430\u043A\u0430\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443. \u0412\u043E\u043A\u0440\u0443\u0433 \u043C\u043E\u0440\u0435 \u0441\u043B\u0435\u0437 \u0438 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0439, \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u0439 \u0438 \u0431\u043E\u043B\u0438. \u043D\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u044F \u0445\u043E\u0447\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0430\u043C: \u0022\u041D\u0435 \u043F\u043B\u0430\u0447\u044C\u0442\u0435 \u0438 \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C. \u0410\u043D\u0434\u0440\u0435\u0439 \u0431\u044B \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0445\u043E\u0442\u0435\u043B. \u0415\u043C\u0443 \u0431\u044B \u044D\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C\u0022. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043B\u0430\u043A\u0430\u0442\u044C - \u043E\u043D \u0431\u044B \u043E\u0433\u043E\u0440\u0447\u0438\u043B\u0441\u044F, \u0442\u0430\u043A\u043E\u0439 \u043E\u043D \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A: \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043B \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u0445, \u043D\u043E \u043D\u0435 \u0445\u043E\u0442\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043B\u0438 \u0437\u0430 \u043D\u0435\u0433\u043E. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043F\u043B\u0430\u0447\u044C\u0442\u0435! \u0420\u0430\u0434