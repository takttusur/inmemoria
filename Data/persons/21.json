u0430\u044E \u043A\u043E\u043D\u044F.\u003Cbr /\u003E\u041E \u0436\u0435\u043B\u0435\u0437\u043D\u0443\u044E \u0441\u043A\u043E\u0431\u043A\u0443\u003Cbr /\u003E\u0441\u0430\u043F\u043E\u0433\u0438 \u043E\u0431\u043E\u0442\u0440\u0443,\u003Cbr /\u003E\u0437\u0430\u043A\u0430\u0436\u0443 \u0441\u0435\u0431\u0435 \u0441\u0442\u043E\u043F\u043A\u0443\u003Cbr /\u003E\u0438 \u0434\u043E\u0441\u0442\u0430\u043D\u0443 \u043C\u0430\u0445\u0440\u0443.\u003Cbr /\u003E\u0414\u0432\u0430 \u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u0445 \u043A\u0430\u0437\u0430\u0445\u0430\u003Cbr /\u003E\u043F\u0440\u0438\u043B\u0430\u0433\u0430\u044E\u0442 \u043A \u0443\u0441\u0442\u0430\u043C\u003Cbr /\u003E\u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u0441\u0430\u0445\u0430\u0440,\u003Cbr /\u003E\u0431\u0443\u0434\u0442\u043E \u0433\u043E\u0440\u043D\u044B\u0439 \u0445\u0440\u0443\u0441\u0442\u0430\u043B\u044C.\u003Cbr /\u003E\u0411\u0440\u044E\u0447\u043A\u0438 \u0433\u0435\u043E\u0433\u0440\u0430\u0444\u0438\u043D\u0438\u003Cbr /\u003E\u0432\u0441\u0435 - \u0440\u0435\u043F\u0435\u0439 \u043D\u0430 \u0440\u0435\u043F\u044C\u0435. \u003Cbr /\u003E\u041E\u0440\u0434\u0435\u043D \u0022\u041C\u0430\u0442\u044C-\u0433\u0435\u0440\u043E\u0438\u043D\u044F\u0022\u003Cbr /\u003E\u0443 \u0446\u044B\u0433\u0430\u043D\u043A\u0438 \u0432 \u0442\u0440\u044F\u043F\u044C\u0435. \u003Cbr /\u003E\u0418, \u043D\u0435\u0432\u0437\u0440\u0430\u0447\u043D\u044B\u0439, \u043F\u043E\u0442\u0435\u0448\u043D\u044B\u0439,\u003Cbr /\u003E\u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0432\u0430\u0442\u044B\u0439 \u043D\u0430 \u0432\u0438\u0434,\u003Cbr /\u003E\u0441\u0442\u0430\u0440\u0438\u043A\u0430\u0448\u043A\u0430 \u043F\u043E\u0434\u0441\u0435\u0432\u0448\u0438\u0439\u003Cbr /\u003E\u043C\u043D\u0435 \u0431\u0435\u0441\u0441\u0432\u044F\u0437\u043D\u043E \u0442\u0432\u0435\u0440\u0434\u0438\u0442,\u003Cbr /\u003E\u043A\u0430\u043A \u0432 \u043F\u0430\u0440\u0430\u0445 \u0441\u0430\u043C\u043E\u0433\u043E\u043D\u043D\u044B\u0445\u003Cbr /\u003E\u0432 \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u043E\u043C \u0434\u044B\u043C\u0443\u003Cbr /\u003E\u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0441\u0430\u043C\u043E\u0440\u043E\u0434\u043E\u043A\u003Cbr /\u003E\u044F\u0432\u043B\u044F\u043B\u0441\u044F \u0435\u043C\u0443,\u003Cbr /\u003E\u043A\u0430\u043A, \u0440\u0430\u0441\u043A\u0440\u044B\u0432 \u0441\u0432\u043E\u044E \u0441\u0443\u043C\u043A\u0443,\u003Cbr /\u003E\u043F\u043E\u0441\u043B\u0435 \u0441\u043E\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0442\u044B\u003Cbr /\u003E\u0441\u0430\u043C\u043E\u0440\u043E\u0434\u043A\u043E\u043C \u043E\u043D \u0441\u0442\u0443\u043A\u043D\u0443\u043B\u003Cbr /\u003E\u0432 \u043A\u0430\u0431\u0430\u043A\u0435 \u043E \u0432\u0435\u0441\u044B,\u003Cbr /\u003E\u043A\u0430\u043A \u0448\u0430\u043B\u0430\u0432\u044B\u0445 \u0434\u0435\u0432\u0447\u043E\u043D\u043E\u043A\u003Cbr /\u003E\u0437\u0430 \u0441\u043E\u0431\u043E\u044E \u0432\u043E\u0434\u0438\u043B\u003Cbr /\u003E\u0438 \u0432 \u043F\u043E\u0440\u0442\u044F\u043D\u043A\u0430\u0445 \u043F\u0430\u0440\u0447\u043E\u0432\u044B\u0445\u003Cbr /\u003E\u043F\u043E \u0418\u0440\u043A\u0443\u0442\u0441\u043A\u0443 \u0445\u043E\u0434\u0438\u043B...\u003Cbr /\u003E\u0412 \u0441\u0442\u0430\u0440\u043E\u0439 \u0440\u0443\u0434\u043D\u0438\u0447\u043D\u043E\u0439 \u0447\u0430\u0439\u043D\u043E\u0439\u003Cbr /\u003E\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C \u0445\u0432\u0430\u0441\u0442\u0443\u043D\u043E\u043C,\u003Cbr /\u003E\u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0438 \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439,\u003Cbr /\u003E\u044F \u0441\u0438\u0436\u0443 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C.\u003Cbr /\u003E\u041F\u044C\u044E \u043D\u0430 \u0437\u0430\u0432\u0438\u0441\u0442\u044C \u043B\u044E\u0431\u043E\u043C\u0443,\u003Cbr /\u003E\u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u0441\u0430\u043F\u043E\u0433\u0438.\u003Cbr 