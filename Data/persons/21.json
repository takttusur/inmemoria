  "Biography": "\u003Cp\u003E\u0420\u043E\u0434\u0438\u043B\u0441\u044F 16 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 1990\u0433.\u003C/p\u003E\r\n\u003Cp\u003E\u0423\u0447\u0438\u043B\u0441\u044F \u0432 \u0448\u043A\u043E\u043B\u0435 \u21169, \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0443\u0447\u0435\u0431\u044B \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043B I \u043C\u0435\u0441\u0442\u043E \u0432 \u043A\u043E\u043D\u043A\u0443\u0440\u0441\u0435 \u0022\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E\u0022, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0441\u044F \u0421\u0425\u041A \u0432 2006\u0433. \u041D\u043E\u043C\u0438\u043D\u0430\u0446\u0438\u044F \u2116 4: \u0022\u0422\u0430\u0439\u043D\u044B \u0430\u0442\u043E\u043C\u043D\u043E\u0433\u043E \u044F\u0434\u0440\u0430 \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0438.\u0022\u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439 \u044F\u0434\u0435\u0440\u043D\u043E\u0439 \u043D\u0430\u0443\u043A\u0438, \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439(\u0026laquo;\u041D\u0430\u0443\u0447\u043D\u043E-\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u043B\u043E\u043A\u0026raquo;) - \u0440\u0430\u0431\u043E\u0442\u0430 \u0022\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u044F\u0434\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043D\u0442\u0435\u0437\u0022 (\u003Ca href=\u0022http://www.atomsib.ru/sci/museum/competitions/Energy_of_the_future/2006/Pobediteli.html\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u0430\u003C/a\u003E).\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u043E\u0441\u043B\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0448\u043A\u043E\u043B\u044B \u043F\u043E\u0441\u0443\u043F\u0438\u043B \u0432 \u0422\u0423\u0421\u0423\u0420 \u043D\u0430 \u0420\u0430\u0434\u0438\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 (\u0420\u0422\u0424), \u043D\u0430 \u043A\u0430\u0444\u0435\u0434\u0440\u0443 \u0420\u0430\u0434\u0438\u043E\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u044B \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 (\u0420\u0417\u0418).\u003C/p\u003E\r\n\u003Cp\u003E\u0412 \u041A\u043B\u0443\u0431\u0435 \u0441 2010\u0433, \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0420\u0422\u0424. \u041F\u043E\u043B\u0438\u0430\u0442\u043B\u043E\u043D\u0438\u0441\u0442, \u043B\u044B\u0436\u043D\u0438\u043A, \u0443\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F \u0432\u0435\u043B\u043E\u0441\u043F\u043E\u0440\u0442\u043E\u043C.\u003Cbr /\u003E\u041C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u0443\u0434\u044C\u044F \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u043E \u043B\u044B\u0436\u043D\u044B\u043C \u0433\u043E\u043D\u043A\u0430\u043C \u043A\u043B\u0443\u0431\u0430 \u0422\u0410\u041A\u0422 \u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u041E\u0441\u0435\u043D\u043D\u0435\u0433\u043E \u043A\u0440\u043E\u0441\u0441\u0430 \u0422\u0410\u041A\u0422. \u041D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u044B\u0439 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0438 \u043F\u0440\u0438\u0437\u0435\u0440 \u041E\u0441\u0435\u043D\u043D\u0435\u0433\u043E \u043A\u0440\u043E\u0441\u0441\u0430 \u0438 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u043E \u043B\u044B\u0436\u043D\u044B\u043C \u0433\u043E\u043D\u043A\u0430\u043C \u043A\u043B\u0443\u0431\u0430 \u0422\u0410\u041A\u0422 (\u003Ca href=\u0022http://takt.tomsk.ru/db/web.page?pid=19245\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u0430\u003C/a\u003E).\u003C/p\u003E\r\n\u003Cp\u003E\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0422\u0410\u041A\u0422\u0430 \u043D\u0430 \u0412\u0441\u0435\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0445 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445 \u043F\u043E \u041F\u0421\u0420 \u0432 \u0421\u043E\u0447\u0438 \u0432 \u043C\u0430\u0440\u0442\u0435 2012\u0433.\u003C/p\u003E\r\n\u003Cp\u003E\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u041E\u0441\u0435\u043D\u043D\u0435\u0433\u043E \u043C\u0430\u0440\u0430\u0444\u043E\u043D\u0430 \u0022\u0411\u0435\u0440\u0435\u043D\u0434\u0435\u0438 - 2011\u0022. 3-\u0439 \u044D\u0442\u0430\u043F \u041A\u0443\u0431\u043A\u0430 \u0421\u0424\u041E (\u0421\u0438\u0431\u0438\u0440\u0441\u043A\u043E\u0433\u043E \u0444\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u043A\u0440\u0443\u0433\u0430) \u043F\u043E \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u043C\u0443 \u0442\u0443\u0440\u0438\u0437\u043C\u0443 \u0026laquo;\u042D\u043A\u0441\u0442\u0440\u0438\u043C-\u041F\u043E\u0445\u043E\u0434\u0026raquo; (\u003Ca href=\u0022http://www.marshruty.ru/Meetings/Meeting.aspx?MeetingID=e0979850-83b8-4d44-a3c0-b245ab6a0555\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u04301\u003C/a\u003E, \u003Ca href=\u0022http://berendei.tsu.ru/?p=1832\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u04302\u003C/a\u003E)\u003C/p\u003E\r\n\u003Cp\u003E\u0412 \u0438\u044E\u043D\u0435 2012 \u0433\u043E\u0434\u0443 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432 \u0444\u043E\u0442\u043E\u043A\u043E\u043D\u043A\u0443\u0440\u0441\u0435 \u0022\u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u043E\u0439 \u043F\u0440\u0430\u0432\u0434\u044B\u0022 - \u0022\u042F \u0438\u0437 \u0422\u043E\u043C\u0441\u043A\u0430 \u0022 (\u003Ca href=\u0022http://www.kp.ru/contest/yaiztomska/6/\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u04301\u003C/a\u003E, \u003Ca href=\u0022http://www.kp.ru/daily/forumcontest/photo/109397\u0022 target=\u0022_blank\u0022\u003E\u0441\u0441\u044B\u043B\u043A\u04302\u003C/a\u003E).\u003C/p\u003E\r\n\u003Cp\u003E\u0412 \u0438\u044E\u043B\u0435 2012\u0433. \u043D\u0430 \u0430\u043B\u044C\u043F\u0441\u0431\u043E\u0440\u0430\u0445 \u0422\u0410\u041A\u0422 \u0432 \u0443\u0449\u0435\u043B\u044C\u0435 \u0410\u043B\u0430-\u0410\u0440\u0447\u0430, \u041A\u0438\u0440\u0433\u0438\u0437\u0441\u043A\u0438\u0439 \u0445\u0440\u0435\u0431\u0435\u0442 \u043F\u0440\u0438 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u043D\u0430 \u043F\u0438\u043A \u0420\u0430\u0446\u0435\u043A\u0430 \u043F\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443 2\u0411 \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043A\u0430\u043C\u043D\u0435\u043F\u0430\u0434\u0430 \u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0432\u043D\u0438\u0437 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u043C\u044B \u0441\u043F\u0438\u043D\u044B. \u0411\u044B\u043B \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u043E\u0432\u0430\u043D \u0432 \u0411\u0438\u0448\u043A\u0435\u043A \u0438 \u0434\u0430\u043B\u0435\u0435 \u041C\u043E\u0441\u043A\u0432\u0443, \u043D\u043E, \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0435 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F, 9 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2012\u0433. \u0410\u043D\u0434\u0440\u0435\u044F \u043D\u0435 \u0441\u0442\u0430\u043B\u043E.\u003C/p\u003E",
