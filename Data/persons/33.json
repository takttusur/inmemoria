E\u043D\u043E\u0432, \u0415. \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432 (3-\u0435 \u043C\u0435\u0441\u0442\u043E \u0432 \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u0430\u0442\u0435 \u0421\u0421\u0421\u0420 \u043F\u043E \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0437\u043C\u0443 \u0432 \u043A\u043B\u0430\u0441\u0441\u0435 \u0432\u044B\u0441\u043E\u0442\u043D\u043E-\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0439).\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u003C/p\u003E","Position":1,"CreateTime":"0001-01-01T00:00:00","Comment":"","Active":1},{"Id":469,"PersonId":0,"Name":"\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0424\u0438\u043B\u0438\u043F\u043F\u043E\u0432 \u041E\u043B\u0435\u0433 \u0412\u0438\u043A\u0442\u043E\u0440\u043E\u0432\u0438\u0447","ResourceType":0,"Rubric":1,"Data":"\u003Cp\u003E\u041D\u043E\u0447\u0435\u0432\u043A\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0448\u0442\u0443\u0440\u043C\u0430. \u041C\u044B\u0448\u0446\u044B, \u0440\u0430\u0431\u043E\u0442\u0430\u0432\u0448\u0438\u0435 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u0430 16 \u0447\u0430\u0441\u043E\u0432, \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043E\u0442\u0434\u044B\u0445\u0430. \u041A\u043E\u0440\u0437\u0443\u043D\u0438\u043D\u0443 \u0441 \u0425\u043E\u043B\u043C\u0430\u043D\u0441\u043A\u0438\u0445 \u0443\u0434\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0440\u0443\u0431\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0432 \u0434\u0432\u0430 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0445 \u043C\u0435\u0442\u0440\u0430, \u0440\u0430\u0441\u0441\u0442\u0438\u043B\u0430\u044E\u0442 \u0434\u043D\u0438\u0449\u0435 \u043F\u0430\u043B\u0430\u0442\u043A\u0438 \u0438 \u0437\u0430\u043B\u0435\u0437\u0430\u044E\u0442 \u0432 \u043D\u0435\u0435. \u041F\u044F\u0442\u0435\u0440\u043E \u0432\u043E\u0448\u043B\u0438, \u0448\u0435\u0441\u0442\u043E\u043C\u0443, \u0414\u044C\u044F\u0447\u0435\u043D\u043A\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u0430. \u041E\u043D \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u044F\u0434\u043E\u043C, \u0432\u043D\u0435 \u043F\u0430\u043B\u0430\u0442\u043A\u0438. \u0422\u0430\u043A \u043E\u043D\u0438 \u0438 \u0441\u0438\u0434\u044F\u0442, \u043E\u0434\u0435\u0442\u044B\u0435 \u0432 \u043F\u0443\u0445\u043E\u0432\u044B\u0435 \u043A\u0443\u0440\u0442\u043A\u0438 \u0438 \u0448\u0442\u0430\u043D\u044B. \u041D\u043E\u0433\u0438 \u0432\u0438\u0441\u044F\u0442 \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E. \u041D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u0448\u0438\u043F\u0438\u0442 \u043F\u0440\u0438\u043C\u0443\u0441. \u0412 \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u0435 \u0443\u0436\u0435 \u0442\u0430\u044E\u0442 \u043A\u0443\u0441\u043A\u0438 \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u043E\u0433\u043E \u043B\u044C\u0434\u0430. \u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u043B\u0430\u0434\u043A\u0438\u0439 \u0447\u0430\u0439. \u0420\u0430\u0437\u0432\u0435 \u043E\u0446\u0435\u043D\u0438\u0448\u044C \u0442\u0430\u043C, \u0432\u043D\u0438\u0437\u0443, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u0443\u0436\u043A\u0438 \u0447\u0430\u044F! \u041E\u043D\u0430 \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442 \u043E\u043A\u043E\u0447\u0435\u043D\u0435\u0432\u0448\u0438\u0435 \u0440\u0443\u043A\u0438. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0435 \u0442\u0435\u043F\u043B\u043E \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E \u0442\u0435\u043B\u0443. \u0411\u0430\u043D\u043A\u0430 \u043A\u043E\u043D\u0441\u0435\u0440