    {
      "Title": "\u0412\u043E\u0441\u043F. \u0425\u0430\u0440\u0438\u0442\u043E\u043D\u043E\u0432\u0430 \u041F\u043E\u043B\u0438\u043D\u0430",
      "Subtitle": "\u0425\u0430\u0440\u0438\u0442\u043E\u043D\u043E\u0432\u0430 \u041F\u043E\u043B\u0438\u043D\u0430",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u041F\u0430\u043F\u0443 \u0441\u0432\u043E\u0435\u0433\u043E \u044F \u043D\u0435 \u0437\u043D\u0430\u044E. \u041E\u043D \u043F\u043E\u0433\u0438\u0431 \u0437\u0430 20 \u0434\u043D\u0435\u0439 \u0434\u043E \u043C\u043E\u0435\u0433\u043E \u0026nbsp;\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u041D\u043E \u044F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043E\u043D \u0431\u044B\u043B \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u0421 \u043C\u0430\u043C\u043E\u0439 \u0026ndash; \u041B\u0435\u043D\u043E\u0439 \u0421\u0435\u043B\u0438\u043D\u043E\u0439 - \u043E\u043D\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C \u0432 \u0422\u0410\u041A\u0422\u0435, \u0026nbsp;\u0438 \u044F \u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u044F \u0026nbsp;- \u0026nbsp;\u0422\u0410\u041A\u0422\u043E\u0432\u043A\u0430 \u0441 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u0026nbsp;\u041C\u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 16 \u043B\u0435\u0442, \u0430 \u0432 \u0433\u043E\u0440\u044B \u044F \u0445\u043E\u0436\u0443 \u0441 4 \u043B\u0435\u0442, \u0026nbsp;\u0431\u044B\u043B\u0430 \u0026nbsp;\u0432 \u0410\u041A-\u0422\u0440\u0443, \u0445\u043E\u0434\u0438\u043B\u0430 \u043D\u0430 \u041A\u0443\u043F\u043E\u043B, \u0026nbsp;\u0431\u044B\u043B\u0430 \u0432 \u0410\u043A\u043A\u0435\u043C\u0435, \u043D\u0430 \u0415\u0440\u0433\u0430\u043A\u0430\u0445, \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u0428\u0430\u0432\u043B\u0438\u043D\u0441\u043A\u0438\u0435 \u043E\u0437\u0435\u0440\u0430, \u0441\u043F\u043B\u0430\u0432 \u0432 \u0417\u0430\u0431\u0430\u0439\u043A\u0430\u043B\u044C\u0435 \u043F\u043E \u0440\u0435\u043A\u0435 \u0418\u043D\u043D\u0430, \u0430 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u043F\u043E \u0440\u0435\u043A\u0435 \u041C\u0435\u043D\u0437\u0430. \u0026nbsp;\u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E \u0436\u0430\u043B\u044C, \u0447\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0438 \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0433\u043E\u0440\u044B, \u0432 \u043F\u043E\u0445\u043E\u0434\u044B \u0441 \u043F\u0430\u043F\u043E\u0439. \u0026nbsp;\u0026nbsp;\u003C/p\u003E",
