{
  "FirstName": "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440",
  "LastName": "\u0428\u0430\u043B\u0430\u0435\u0432",
  "MaidenName": "",
  "Patronymic": "\u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u0438\u0447",
  "Nickname": "",
  "Birthday": "1955-05-03T00:00:00Z",
  "DeathDay": "1999-02-19T00:00:00Z",
  "Biography": "\u003Cp\u003E\u0428\u0430\u043B\u0430\u0435\u0432 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u0438\u0447 \u0440\u043E\u0434\u0438\u043B\u0441\u044F 3 \u043C\u0430\u044F 1955\u0433. \u041F\u0440\u0438\u0448\u0451\u043B \u0432 \u0422\u0410\u041A\u0422 \u0432 1974\u0433. \u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043B \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u0432\u0441\u0435\u0445 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0439 \u043A\u043B\u0443\u0431\u0430. \u0412 1978 \u0433. \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0443\u0435\u0445\u0430\u043B \u0441 \u0441\u0435\u043C\u044C\u0451\u0439 \u0432 \u041A\u0443\u0440\u0433\u0430\u043D. \u0421\u0442\u0430\u043B \u0438 \u0442\u0430\u043C \u0434\u0443\u0448\u043E\u0439 \u043A\u043B\u0443\u0431\u0430 \u0433\u043E\u0440\u043D\u044B\u0445 \u0442\u0443\u0440\u0438\u0441\u0442\u043E\u0432. \u0421 \u0435\u0433\u043E \u043F\u043E\u0434\u0430\u0447\u0438 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0442\u0435\u0441\u043D\u0430\u044F \u0434\u0440\u0443\u0436\u0431\u0430 \u0422\u043E\u043C\u0441\u043A\u043E\u0439 \u0438 \u041A\u0443\u0440\u0433\u0430\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u0432\u043E \u0412\u0441\u0435\u0441\u043E\u044E\u0437\u043D\u044B\u0445 \u0438 \u0412\u0441\u0435\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0445 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445 \u043F\u043E \u0442\u0435\u0445\u043D\u0438\u043A\u0435 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0442\u0443\u0440\u0438\u0437\u043C\u0430. \u0421\u0430\u0448\u0430 \u0431\u044B\u043B \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u043E\u043C \u043A\u043E\u043C\u0430\u043D\u0434\u044B. \u0425\u043E\u0434\u0438\u043B \u0438 \u0432\u043E\u0434\u0438\u043B \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u043E\u0445\u043E\u0434\u044B, \u0441\u043F\u043B\u0430\u0432\u043B\u044F\u043B\u0441\u044F \u043D\u0430 \u0431\u0430\u0439\u0434\u0430\u0440\u043A\u0430\u0445. \u0412 1982 \u0433\u043E\u0434\u0443 \u043F\u043E\u0445\u043E\u0434 5\u043A.\u0441. \u043F\u043E\u0434 \u0435\u0433\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0437\u0430\u043D\u044F\u043B 1 \u043C\u0435\u0441\u0442\u043E \u0432 \u0427\u0435\u043C\u043F\u0438\u043E\u043D\u0430\u0442\u0435 \u0414\u0421\u041E \u0022\u0417\u0435\u043D\u0438\u0442\u0022. \u0421\u0430\u0448\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0437\u0432\u0430\u043D\u0438\u0435 \u0022\u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u043F\u043E\u0440\u0442\u0430 \u0421\u0421\u0421\u0420\u0022. \u0412 1992\u0433. \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u0438\u043A \u041B\u0435\u043D\u0438\u043D\u0430. \u0412 1997 \u0433\u043E\u0434\u0443 \u0428\u0430\u043B\u0430\u0435\u0432\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0432 \u0422\u043E\u043C\u0441\u043A.\u003C/p\u003E\r\n\u003Cp\u003E\u0422\u044F\u0436\u0451\u043B\u0430\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u044C... 19 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 1999 \u0433\u043E\u0434\u0430 \u0421\u0430\u0448\u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u043E. \u041E \u043D\u0435\u043C \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0444\u0438\u043B\u044C\u043C\u044B, \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0438 \u043D\u0430\u0448\u0430 \u0434\u043E\u0431\u0440\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C.\u003C/p\u003E",
  "Active": true,
  "AttachmentsStorageId": 35,
  "Attachments": [
    {
      "Title": "\u0414\u0440\u0443\u0437\u044C\u044F \u0421\u0430\u0448\u0438 \u0428\u0430\u043B\u0430\u0435\u0432\u0430",
      "Subtitle": "\u0414\u0440\u0443\u0437\u044C\u044F \u0421\u0430\u0448\u0438 \u0428\u0430\u043B\u0430\u0435\u0432\u0430",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u0421\u0430\u0448\u0430 \u0428\u0430\u043B\u0430\u0435\u0432 \u043F\u0440\u0438\u0448\u0451\u043B \u0432 \u0422\u0410\u041A\u0422 \u0432 1974 \u0433 \u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043B \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u0432\u0441\u0435\u0445 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0439 \u043A\u043B\u0443\u0431\u0430.\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u0435\u0440\u0432\u044B\u0439 \u043D\u0430\u0431\u043E\u0440 \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0424\u0421\u0423 1974 \u0433\u043E\u0434\u0430 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0441\u044F \u0438\u0445 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E, \u0437\u0432\u043E\u043D\u043A\u043E\u0439 \u0432\u0435\u0441\u0435\u043B\u043E\u0441\u0442\u044C\u044E \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E. \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438, \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u043D\u044B\u0435 \u0432\u044B\u0445\u043E\u0434\u044B, \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0435 \u0447\u0430\u0435\u043F\u0438\u0442\u0438\u044F - \u043E\u0431\u0449\u0435\u043D\u0438\u0435, \u043D\u043E\u0432\u044B\u0435 \u0434\u0440\u0443\u0437\u044C\u044F \u0438 \u043D\u043E\u0432\u0430\u044F \u043C\u0435\u0447\u0442\u0430 - \u0433\u043E\u0440\u044B \u0441\u0440\u043E\u0434\u043D\u0438\u043B\u0438 \u0438 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438. \u041F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u043E\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u043B\u0435\u0442\u0430 (\u0421\u0430\u0448\u0430 \u0445\u043E\u0434\u0438\u043B 2\u043A.\u0441. \u043F\u043E \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0422\u044F\u043D\u044C-\u0428\u0430\u043D\u044E - \u0431\u044B\u043B\u043E \u0442\u0440\u0443\u0434\u043D\u043E!), \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u043E\u0439 \u043D\u0430 \u0022\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u0022, \u043C\u043D\u043E\u0433\u0438\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C, \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0442\u0435, \u043A\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043E\u0446\u0435\u043D\u043A\u0443 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0434\u0440\u0443\u0437\u0435\u0439 \u0437\u0430 \u044D\u0442\u0443 \u0441\u0430\u043C\u0443\u044E \u0022\u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u0022.\u003C/p\u003E\r\n\u003Cp\u003E\u041F\u0440\u043E\u0448\u043B\u043E \u0443\u0436\u0435 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442, \u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C - \u044D\u0442\u043E \u0431\u044B\u043B \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u0430\u0436\u043D\u044B\u0445 \u0022\u044D\u043A\u0437\u0430\u043C\u0435\u043D\u043E\u0432\u0022 \u0432 \u0436\u0438\u0437\u043D\u0438. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0022\u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430\u0022 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0434\u0440\u0443\u0437\u044C\u044F - \u043E\u0447\u0435\u043D\u044C \u043D\u0430\u0434\u0435\u0436\u043D\u044B\u0435, \u043E\u0447\u0435\u043D\u044C \u0432\u0435\u0440\u043D\u044B\u0435, \u043D\u0430\u0447\u0430\u0441\u044C \u0022\u0414\u0420\u0423\u0416\u0411\u0410\u0022, \u0431\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0432\u044B\u0436\u0438\u0442\u044C - \u0432\u0435\u0434\u044C \u0431\u044B\u0432\u0430\u043B\u043E \u0443\u0436\u0435 \u0432 \u043D\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043D\u0438 \u0432\u0441\u044F\u043A\u043E\u0435. \u041A\u0442\u043E-\u0442\u043E \u0442\u0435\u0440\u044F\u043B \u0431\u0430\u043B\u043B\u044B \u043F\u0440\u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435 \u0022\u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438\u0022, \u043A\u0442\u043E-\u0442\u043E \u043D\u0430\u0431\u0438\u0440\u0430\u043B \u0438\u0445, \u0434\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u043B\u0441\u044F \u0434\u043E \u043F\u043B\u0430\u043D\u043A\u0438 \u041B\u0418\u0414\u0415\u0420\u0410. \u0421\u0430\u0448\u0430 \u0431\u044B\u043B \u043B\u0438\u0434\u0435\u0440\u043E\u043C.\u003C/p\u003E\r\n\u003Cp\u003E\u0421 1976 \u0433\u043E\u0434\u0430 \u043D\u0430\u0447\u0430\u043B \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0424\u0421\u0423 \u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u043F\u043E\u0445\u043E\u0434\u0430\u043C\u0438 2, 3, 4 \u043A.\u0441. \u0425\u043E\u0434\u0438\u0442\u044C \u043F\u043E\u0434 \u0435\u0433\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0431\u044B\u043B\u043E \u043B\u0435\u0433\u043A\u043E \u0438 \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E. \u0416\u0451\u0441\u0442\u043A\u0430\u044F \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430, \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u044C, \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C, \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043D\u0435\u0438\u0437\u043C\u0435\u043D\u043D\u043E \u0441\u043E\u0447\u0435\u0442\u0430\u043B\u0438\u0441\u044C \u0441 \u0447\u0443\u0442\u043A\u0438\u043C, \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435\u043C \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C. \u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0440\u0430\u0434\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0432\u0441\u0435\u0433\u0434\u0430, \u0438 \u0447\u0435\u043C \u0442\u0440\u0443\u0434\u043D\u0435\u0435 \u0438 \u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u0431\u044B\u043B \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A, \u0442\u0435\u043C \u0432\u0435\u0441\u0435\u043B\u0435\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B \u043E\u0442\u0434\u044B\u0445. \u041F\u0440\u0438 \u043B\u044E\u0431\u043E\u043C \u0443\u0434\u043E\u0431\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043B\u0438\u0441\u044C \u0442\u0430\u043D\u0446\u044B, \u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u0438, \u0431\u0430\u043B\u0434\u0451\u0436. \u0428\u0443\u0440\u043A\u0430 \u043B\u044E\u0431\u0438\u043B \u043F\u0435\u0442\u044C, \u0438\u0433\u0440\u0430\u043B \u043D\u0430 \u0433\u0438\u0442\u0430\u0440\u0435, \u0441\u043D\u0438\u043C\u0430\u043B \u0444\u0438\u043B\u044C\u043C\u044B, \u0448\u0443\u0442\u0438\u043B. \u0412\u043E\u0437\u043B\u0435 \u043D\u0435\u0433\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u043E \u0442\u0435\u043F\u043B\u043E. \u041E\u043D \u0431\u0440\u0430\u043B \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0441\u0435\u0431\u044F, \u043D\u0435 \u0431\u043E\u044F\u043B\u0441\u044F \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439 \u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u043B \u0441\u0430\u043C\u0443\u044E \u0442\u044F\u0436\u0435\u043B\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443.\u003C/p\u003E\r\n\u003Cp\u003E\u0412 1978 \u0433. \u0421\u0430\u0448\u0430 \u0443\u0435\u0445\u0430\u043B \u0441 \u0441\u0435\u043C\u044C\u0451\u0439 \u0432 \u041A\u0443\u0440\u0433\u0430\u043D. \u0421\u0442\u0430\u043B \u0438 \u0442\u0430\u043C \u0434\u0443\u0448\u043E\u0439 \u043A\u043B\u0443\u0431\u0430 \u0433\u043E\u0440\u043D\u044B\u0445 \u0442\u0443\u0440\u0438\u0441\u0442\u043E\u0432. \u0421 \u0435\u0433\u043E \u043F\u043E\u0434\u0430\u0447\u0438 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0442\u0435\u0441\u043D\u0430\u044F \u0434\u0440\u0443\u0436\u0431\u0430 \u0422\u043E\u043C\u0441\u043A\u043E\u0439 \u0438 \u041A\u0443\u0440\u0433\u0430\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u0432\u043E \u0412\u0441\u0435\u0441\u043E\u044E\u0437\u043D\u044B\u0445 \u0438 \u0432\u0441\u0435\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0445 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u0445 \u043F\u043E \u0442\u0435\u0445\u043D\u0438\u043A\u0435 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0442\u0443\u0440\u0438\u0437\u043C\u0430. \u0421\u0430\u0448\u0430 \u0431\u044B\u043B \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u043E\u043C \u043A\u043E\u043C\u0430\u043D\u0434\u044B. \u0425\u043E\u0434\u0438\u043B \u0438 \u0432\u043E\u0434\u0438\u043B \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u043E\u0445\u043E\u0434\u044B, \u0441\u043F\u043B\u0430\u0432\u043B\u044F\u043B\u0441\u044F \u043D\u0430 \u0431\u0430\u0439\u0434\u0430\u0440\u043A\u0430\u0445. \u0412 1982 \u0433\u043E\u0434\u0443 \u043F\u043E\u0445\u043E\u0434 5\u043A.\u0441. \u043F\u043E\u0434 \u0435\u0433\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0437\u0430\u043D\u044F\u043B 1 \u043C\u0435\u0441\u0442\u043E \u0432 \u0427\u0435\u043C\u043F\u0438\u043E\u043D\u0430\u0442\u0435 \u0414\u0421\u041E \u0022\u0417\u0435\u043D\u0438\u0442\u0022. \u0421\u0430\u0448\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0437\u0432\u0430\u043D\u0438\u0435 \u0022\u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u043F\u043E\u0440\u0442\u0430 \u0421\u0421\u0421\u0420\u0022. \u0412 1992\u0433. \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u0432\u043E\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u0438\u043A \u041B\u0435\u043D\u0438\u043D\u0430.\u003C/p\u003E\r\n\u003Cp\u003E\u0412 1997 \u0433\u043E\u0434\u0443 \u0428\u0430\u043B\u0430\u0435\u0432\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0432 \u0422\u043E\u043C\u0441\u043A. \u0421\u0430\u0448\u0430 \u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0441\u044F \u043D\u043E\u0432\u043E\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435, \u0434\u0440\u0443\u0437\u044C\u044F\u043C, \u0445\u043E\u0434\u0438\u043B \u043D\u0430 \u0441\u043B\u0451\u0442\u044B, \u0431\u0435\u0433\u0430\u043B \u043D\u0430 \u043B\u044B\u0436\u0430\u0445, \u043C\u0435\u0447\u0442\u0430\u043B \u043E \u0433\u043E\u0440\u0430\u0445 \u0438 \u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u0445\u043E\u0434\u0430\u0445.\u003C/p\u003E\r\n\u003Cp\u003E\u0422\u044F\u0436\u0451\u043B\u0430\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u044C... 19 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 1999 \u0433\u043E\u0434\u0430 \u0421\u0430\u0448\u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u043E. \u041E \u0428\u0443\u0440\u043A\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0444\u0438\u043B\u044C\u043C\u044B, \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0438 \u043D\u0430\u0448\u0430 \u0434\u043E\u0431\u0440\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C.\u003C/p\u003E\r\n\u003Cp\u003E\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0421\u0430\u0448\u0430, \u0447\u0442\u043E \u0442\u044B \u0431\u044B\u043B!\u003C/p\u003E",
