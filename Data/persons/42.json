3A\u0442\u0438\u0432\u0430 \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0435 \u041C.\u041A. \u0427\u043C\u044B\u0445\u0430 \u0432 1994 \u0433\u043E\u0434\u0443 \u0443 \u043D\u0430\u0441 \u043D\u0430 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u043D\u043E\u0432\u0430\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0026laquo;\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044F \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E \u0440\u0430\u0434\u0438\u043E\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0026raquo;. \u0412\u0441\u0451 \u044D\u0442\u043E \u0441\u043A\u0443\u043F\u044B\u0435 \u0444\u0430\u043A\u0442\u044B. \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u0026mdash; \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u041C\u0438\u0445\u0430\u0438\u043B\u0430 \u041A\u0438\u0440\u0438\u043B\u043B\u043E\u0432\u0438\u0447\u0430: \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u0438\u0435 \u043A \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u0431\u043B\u0430\u0433\u0430\u043C, \u0431\u0435\u0441\u043A\u043E\u0440\u044B\u0441\u0442\u0438\u0435, \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0441\u0442\u044C \u043A \u043E\u0431\u0449\u0435\u043D\u0438\u044E, \u0434\u043E\u0432\u0435\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u044C. \u041E\u043D \u043E\u0431\u043E\u0436\u0430\u043B \u043F\u0440\u0438\u0440\u043E\u0434\u0443, \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u0432 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438, \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u043B \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443, \u0442\u0435\u0430\u0442\u0440\u003C/p\u003E\r\n\u003Cp\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: Arial; mso-fareast-font-family: \u0027Times New Roman\u0027; color: #222222; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA;\u0022\u003E\u0026nbsp;\u003C/span\u003E\u003Cspan style=\u0022font-size: 12.0pt; font-family: \u0027Times New Roman\u0027; mso-fareast-font-family: \u0027Times New Roman\u0027; mso-ansi-language: RU; mso-fareast-language: RU; mso-bidi-language: AR-SA;\u0022\u003E\u003Ca href=\u0022http://gazeta.sfu-kras.ru/node/2496\u0022\u003Ehttp://gazeta.sfu-kras.ru/node/2496\u003C/a\u003E\u003C/span\u003E\u003C/p\u003E\r\n\u003Cp\u003E\u0026nbsp;\u0026nbsp;\u003C/p\u003E","Position":1,"CreateTime":"2012-09-13T11:14:59","Comment":"\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0413\u0440\u043E\u043C\u044B\u043A\u043E","Active":1}]}