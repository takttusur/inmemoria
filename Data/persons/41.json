32\u0430\u043B\u0435\u043D\u043A\u043E, \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F \u0026laquo;\u0420\u043E\u0441\u0442\u0430 \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432\u0026raquo;, \u0438 \u044F (\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C \u0440\u0430\u0431\u043E\u0442) \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0026laquo;\u0414\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0438 \u0438 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0438\u0026raquo;. \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438, \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u0438 \u043F\u043E\u043B\u0441\u0442\u0430\u0432\u043A\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u043D\u0442\u0430. \u041F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0442\u0431\u043E\u0440\u0430: \u0442\u0443\u0440\u0438\u0441\u0442\u044B, \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0441\u0442\u044B \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C. \u041C\u043D\u043E\u0433\u043E \u0431\u044B\u043B\u043E \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439, \u043D\u043E \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u0431\u044B\u043B\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u044D\u0442\u043E\u0439