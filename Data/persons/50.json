2\u043E\u0441\u043F\u043E\u043C - \u0412\u0430\u0441\u0438\u043B\u0438\u0439 \u0413\u0440\u0438\u0433\u043E\u0440\u044C\u0435\u0432","ResourceType":"html","Rubric":"memoir","Data":"\u003Cp\u003E\u041C\u044B \u0431\u044B\u043B\u0438 \u0432 \u043E\u0434\u043D\u043E\u043C \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432\u043E\u043C \u043F\u043E\u0442\u043E\u043A\u0435 83 \u0433\u043E\u0434\u0430 \u043D\u0430 \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0430\u0445 \u0420\u0424-\u0424\u0421\u0423 (\u0442\u043E\u0433\u0434\u0430 \u0435\u0449\u0435 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u044B). \u0420\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043F\u043E \u043F\u043E\u0445\u043E\u0434\u0430\u043C (\u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0438 \u0438\u0437 \u0420\u0422\u0424 - \u0434\u0435\u0432\u043E\u0447\u043A\u0438 \u0438\u0437 \u0424\u0421\u0423) \u0438 \u043F\u0443\u0442\u0435\u0432\u043A\u0430\u043C \u0441\u0432\u043E\u0434\u0438\u043B\u043E \u043D\u0430\u0441 \u0432\u043C\u0435\u0441\u0442\u0435 2 \u0433\u043E\u0434\u0430 \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435.\u0026nbsp; \u043F\u0435\u0440\u0432\u0443\u044E \u0435\u0434\u0438\u043D\u0438\u0447\u043A\u0443,\u0026nbsp; \u0432 \u043D\u043E\u0432\u0438\u0447\u043A\u0438 \u0432 \u0414\u0443\u0433\u043E\u0431\u0443 , \u043F\u043E\u0442\u043E\u043C \u043D\u0430 3-\u0439 \u0440\u0430\u0437\u0440\u0430\u0434 \u0432 \u0422\u0443\u044E\u043A-\u0421\u0443 \u0438 \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u0445\u043E\u0434 2-\u043A\u0430\u0026nbsp; \u043F\u043E \u0417\u0430\u0438\u043B\u0438\u0439\u0441\u043A\u043E\u043C\u0443.\u003Cbr /\u003E\u041B\u044E\u0441\u044F, \u041B\u044E\u0441\u0438 - \u0438\u0437\u044F\u0449\u043D\u0430\u044F, \u0432\u043E\u0441\u0442\u043E\u0440\u0436\u0435\u043D\u043D\u0430\u044F, \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043E\u043D\u0430\u044F \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u0430\u044F \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E-\u0430\u0437\u0438\u0430\u0442\u0441\u043A\u0430\u044F \u0434\u0435\u0432\u0443\u0448\u043A\u0430.\u003Cbr /\u003E\u0414\u0430\u0436\u0435 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E \u0431\u044B\u043B\u043E, \u043A\u0430\u043A \u0438 \u0437\u0430\u0447\u0435\u043C \u044D\u0442\u043E \u0445\u0440\u0443\u043F\u043A\u043E\u0435 (\u043D\u0430 \u0432\u0438\u0434) \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u0430\u0441\u043A\u0430\u0435\u0442 \u0440\u044E\u043A\u0437\u0430\u043A\u0438 \u0438 \u043F\u043E\u043A\u043E\u0440\u044F\u0435\u0442 \u0432\u0435\u0440\u0448\u0438\u043D\u044B. \u0410 \u0432\u0435\u0434\u044C \u0443 \u043D\u0435\u0451 \u0445\u0432\u0430\u0442\u0430\u043B\u043E \u0443\u043F\u043E\u0440\u0441\u0442\u0432\u0430 \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0430 - \u0438 \u043D\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430\u0445, \u0438 \u0432 \u0433\u043E\u0440\u0430\u0445.\u003Cbr /\u003E\u041F\u0443\u0442\u0438 \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C ( \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0437 \u043F\u0430\u043C\u044F\u0442\u0438 \u0441\u0442\u0435\u0440\u043B\u043E\u0441\u044C) - \u0442\u0430\u043A \u043E\u043D\u0430 \u0438 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u044E\u043D\u043E\u0439 \u041B\u044E\u0441\u0438 \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0442\u0430\u043A\u0442\u043E\u0432\u0441\u043A\u0438\u0445 \u043B\u0435\u0442.\u003C/p\u003E","Position":0,"CreateTime":"2012-10-29T02:57:45","Comment":"\u0412\u0430\u0441\u0438\u043B\u0438\u0439 \u0413\u04