    {
      "Title": "\u0421\u043B\u0435\u0442-\u0411\u0430\u0439\u043A\u0430\u043B",
      "Subtitle": "\u041F\u0435\u0448\u0438\u0439 \u043F\u043E\u0445\u043E\u0434 4 \u043A.\u0441. \u043F\u043E \u043F\u0440\u0438\u0431\u0430\u0439\u043A\u0430\u043B\u044C\u0441\u043A\u043E\u0439 \u0442\u0430\u0439\u0433\u0435. 1966\u0433.",
      "IsActive": true,
      "Data": "1966\u0433. \u0412\u0441\u0435\u0441\u043E\u044E\u0437\u043D\u044B\u0439 \u0441\u043B\u0435\u0442 \u0442\u0443\u0440\u0438\u0441\u0442\u043E\u0432 \u0412\u0421 \u0414\u0421\u041E \u0022\u0411\u0443\u0440\u0435\u0432\u0435\u0441\u0442\u043D\u0438\u043A\u0022 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0411\u0430\u0439\u043A\u0430\u043B\u0430.\r\n\u041F\u043E\u0441\u043B\u0435 \u0441\u043B\u0435\u0442\u0430 \u043F\u0435\u0448\u0438\u0439 \u043F\u043E\u0445\u043E\u0434 4 \u043A.\u0441. \u043F\u043E \u043F\u0440\u0438\u0431\u0430\u0439\u043A\u0430\u043B\u044C\u0441\u043A\u043E\u0439 \u0442\u0430\u0439\u0433\u0435. \u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438: \u041D\u0438\u043A\u0438\u0442\u0438\u043D \u0421\u043B\u0430\u0432\u0430, \u0424\u0435\u0434\u043E\u0440\u043E\u0432 \u0412\u043E\u0432\u0430, \u0410\u0433\u0430\u043B\u0430\u043A\u043E\u0432 \u0411\u043E\u0440\u044F, \u0417\u0443\u0431\u0430\u0440\u0435\u0432\u0430 (\u0417\u0435\u0440\u043D\u043E\u0432\u0430) \u041D\u0430\u0434\u044F, \u041F\u0443\u043F\u0430\u0441\u043E\u0432\u0430 (\u0414\u0435\u043D\u0438\u0441\u043E\u0432\u0430) \u041D\u0430\u0434\u044F, \u0412\u0430\u043B\u044F \u0418\u0432\u0430\u043D\u043E\u0432\u0430, \u041F\u0435\u0442\u0440\u043E\u0432 \u042E\u0440\u0438\u0439.\r\n\u041F\u043E\u0441\u043B\u0435 \u0441\u043B\u0435\u0442\u0430 \u0438 \u043F\u043E\u0445\u043E\u0434\u0430 \u043C\u0443\u0436\u0441\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0445\u043E\u0434\u0430, \u043D\u0435 \u0434\u043E\u0435\u0437\u0436\u0430\u044F \u0422\u043E\u043C\u0441\u043A\u0430 \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u0422\u0430\u0439\u0433\u0435 \u0432 \u043F\u043E\u0435\u0437\u0434 \u0434\u043E \u0410\u043B\u043C\u0430-\u0410\u0442\u044B \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u0430\u043B\u044C\u043F\u043B\u0430\u0433\u0435\u0440\u044C \u00AB\u0422\u0430\u043B\u0433\u0430\u0440\u00BB\r\n",
