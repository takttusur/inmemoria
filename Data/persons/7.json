44B\u0432 \u0411\u043E\u0440\u044F \u0440\u0435\u0448\u0438\u043B \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u0438\u0442\u044C \u043B\u0438\u0447\u043D\u043E \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0430\u043A \u043D\u0430\u0434\u043E \u0445\u043E\u0434\u0438\u0442\u044C \u043F\u043E \u0433\u043E\u0440\u043D\u044B\u043C \u0440\u0435\u043A\u0430\u043C. \u041E\u0431\u043B\u0430\u0447\u0438\u0432\u0448\u0438\u0441\u044C \u0432 \u0441\u043F\u0430\u0441\u0436\u0438\u043B\u0435\u0442\u044B, \u043C\u044B \u0441 \u0411\u043E\u0440\u0435\u0439 \u0432\u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0438 \u0432 \u043B\u043E\u0434\u043A\u0443 \u0438 \u043F\u043E\u043D\u0435\u0441\u043B\u0438\u0441\u044C \u0432 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u0442\u043E\u043A\u0435. \u041D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438 \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u044C\u0441\u044F, \u043A\u0430\u043A \u0432\u043B\u0435\u0442\u0435\u043B\u0438 \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u0441\u0442\u0443\u043F\u0435\u043D\u044C \u043F\u043E\u0440\u043E\u0433\u0430. \u041D\u0430\u0441 \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043D\u0430\u043A\u0440\u044B\u043B \u0432\u0430\u043B \u0432\u043E\u0434\u044B, \u0438 \u043B\u043E\u0434\u043A\u0430, \u043A\u0430\u043A \u043C\u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0434\u043D\u043E \u0440\u0435\u043A\u0438. \u041D\u043E \u0437\u0430\u0442\u0435\u043C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0432\u0441\u043F\u043B\u044B\u043B\u0430 \u0438 \u043F\u043E\u043D\u0435\u0441\u043B\u0430\u0441\u044C \u0434\u0430\u043B\u044C\u0448\u0435. \u0412 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043D\u0430\u0441 \u0443\u043D\u0435\u0441\u043B\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u043D\u0430 \u043F\u043E\u043B\u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u0430 \u0432\u043D\u0438\u0437. \u041E\u0448\u0430\u043B\u0435\u043B\u043E \u0433\u043B\u044F\u0434\u044F \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430, \u043C\u044B \u043C\u043E\u043B\u0447\u0430\u043B\u0438. \u0417\u0430 \u0442\u0435\u043C \u0411\u043E\u0440\u044F \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441: \u0026laquo;\u0415\u0441\u043B\u0438 \u043D\u0435 \u0443\u0442\u043E\u043D\u0435\u043C, \u0442\u043E \u0441\u043F\u043B\u0430\u0432\u0438\u043C\u0441\u044F \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E\u0026raquo;. \u0415\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u043E\u0440\u043E\u0447\u0435\u0441\u043A\u0438\u043C\u0438.\u003C/p\u003E\r\n\u003Cp\u003E\u041C\u044B \u0432\u044B\u0448\u043B\u0438 \u043D\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 20 \u0430\u0432\u0433\u0443\u0441\u0442\u0430, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u044B\u0435 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0433\u043E\u0442\u043E\u0432\u044F\u0442\u0441\u044F \u0443\u0447\u0438\u0442\u044C\u0441\u044F. \u0418 \u0432\u043E\u0442 \u0443\u0436\u0435 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044C \u0431\u043B\u0438\u0437\u0438\u043B\u0441\u044F \u043A \u043A\u043E\u043D\u0446\u0443. \u0421\u043F\u0435\u0448\u0438\u0442\u044C \u0431\u044B\u043B\u043E \u043D\u0435\u043A\u0443\u0434\u0430. \u0412\u0435\u0434\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E \u0431\u044B\u043B\u043E \u0442\u043E, \u0447\u0442\u043E \u043E\u0442\u0447\u0438\u0441\u043B\u044F\u0442 \u0432\u0441\u0435\u0445, \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0434\u0438\u043F\u043B\u043E\u043C\u043D\u0438\u043A\u0438. \u041C\u044B \u043D\u0435 \u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E \u0411\u043E\u0440\u044F, \u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0442\u0435\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043B \u043A\u0430\u043D\u0430\u043B \u0440\u0430\u0434\u0438\u043E\u0441\u0432\u044F\u0437\u0438 \u0441 \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u043E\u043C (\u0442\u0438\u0440\u0438\u044D\u0442\u043E\u0432\u0435\u0446, \u0431\u043B\u0438\u043D!) \u0438 \u0438\u0437\u043B\u043E\u0432\u0447\u0438\u043B\u0441\u044F \u0438\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0440\u043E\u043A\u0430 \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u043E\u043C \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430 \u043F\u043E\u043F\u0430\u043B\u0430 \u0432 \u0441\u043B\u043E\u0436\u043D\u0443\u044E \u0441\u043D\u0435\u0436\u043D\u043E-\u043B\u0435\u0434\u043E\u0432\u0443\u044E \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u043B\u0435\u0434\u044F\u043D\u044B\u0435 \u0437\u0430\u0442\u043E\u0440\u044B \u043D\u0430 \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0417\u0435\u043C\u043B\u044E. \u041D\u043E, \u043C\u043E\u043B, \u043F\u043E\u0432\u043E\u0434\u0430 \u0434\u043B\u044F \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0430 \u043D\u0435\u0442, \u0432\u0441\u0435 \u0436\u0438\u0432\u0435\u043D\u044C\u043A\u0438 \u0026ndash; \u0437\u0434\u043E\u0440\u043E\u0432\u0435\u043D\u044C\u043A\u0438, \u0447\u0435\u0433\u043E \u0438 \u0432\u0430\u043C \u0436\u0435\u043B\u0430\u0435\u043C. \u0410\u0439 \u0434\u0430 \u0411\u043E\u0440\u