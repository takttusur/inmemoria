      "Subtitle": "\u041A\u0430\u0437\u0430\u043A\u043E\u0432\u0430 \u041B.\u0421. (\u0421\u0435\u043B\u0438\u043D\u0430)",
      "IsActive": true,
      "Data": "\u003Cp\u003E\u0412\u043E\u0434\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u043F\u043E \u0414\u0430\u043B\u044C\u043D\u0435\u043C\u0443 \u0412\u043E\u0441\u0442\u043E\u043A\u0443, \u0430\u0432\u0433\u0443\u0441\u0442 1968: \u0026laquo;\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u0411. \u0410\u0433\u0430\u043B\u0430\u043A\u043E\u0432 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0432\u043E\u0437\u044C\u043C\u0435\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u044B \u0438 \u043C\u0443\u043A\u0443, \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0434\u043E\u0431\u0443\u0434\u0435\u043C \u0432 \u0442\u0430\u0439\u0433\u0435. \u041D\u043E \u044F, \u043A\u0430\u043A \u0437\u0430\u0432\u0445\u043E\u0437, \u043E\u0442\u0432\u043E\u0435\u0432\u0430\u043B\u0430 \u0448\u0442\u0443\u043A 15 \u0431\u0430\u043D\u043E\u043A \u0442\u0443\u0448\u0435\u043D\u043A\u0438, \u043A\u043E\u0435-\u043A\u0430\u043A\u0438\u0435 \u043A\u0440\u0443\u043F\u044B. \u0418 \u043A\u0430\u043A \u0436\u0435 \u043C\u044B \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C, \u043A\u043E\u0433\u0434\u0430 \u0432 \u0442\u0430\u0439\u0433\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u044B\u0433\u0430\u043B\u043E \u043F\u043E\u0434 \u0440\u0443\u0436\u044C\u0435, \u0430 \u0441\u0435\u0442\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C \u0438\u043B\u0438 \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0443\u043F\u043B\u044B\u0442\u044C, \u0438\u043B\u0438 \u0432 \u043D\u0435\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043B\u0441\u044F \u043E\u0434\u0438\u043D \u043D\u0435\u043F\u0443\u0433\u0430\u043D\u044B\u0439 \u043B\u0435\u043D\u043E\u043A. \u0414\u043E\u0431\u0438\u043B\u0438 \u043D\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0435 \u0433\u0435\u043E\u043B\u043E\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438, \u0447\u0442\u043E \u0022\u041B\u0443\u0447\u0448\u0438\u0439 \u0440\u044F\u0431\u0447\u0438\u043A \u0026ndash; \u044D\u0442\u043E \u0442\u0443\u0448\u0435\u043D\u043A\u0430!\u0022...\u003C/p\u003E",
