    {
      "Title": "\u041F\u043E\u0445\u043E\u0434 \u0432\u043E\u0434 \u0414\u0412 1968",
      "Subtitle": "\u0410\u0432\u0433\u0443\u0441\u0442 1968\u0433. \u0412\u043E\u0434\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0412\u043E\u0441\u0442\u043E\u043A",
      "IsActive": true,
      "Data": "\u0410\u0432\u0433\u0443\u0441\u0442 1968\u0433. \u0412\u043E\u0434\u043D\u044B\u0439 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0412\u043E\u0441\u0442\u043E\u043A \u043D\u0430 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445 \u043B\u043E\u0434\u043A\u0430\u0445. \u0421\u043F\u043B\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C \u043F\u043E \u0440\u0435\u043A\u0430\u043C \u0417\u0435\u044F \u0438 \u041A\u0443\u043F\u0443\u0440\u0438.\r\n\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C: \u0410\u0433\u0430\u043B\u0430\u043A\u043E\u0432 \u0411\u043E\u0440\u0438\u0441\r\n\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438: \u0421\u0435\u043B\u0438\u043D \u0413\u0435\u043D\u043D\u0430\u0434\u0438\u0439, \u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432 \u0413\u0435\u043D\u043D\u0430\u0434\u0438\u0439, \u041A\u0430\u0437\u0430\u043A\u043E\u0432\u0430 \u041B\u044E\u0434\u043C\u0438\u043B\u0430, \u0425\u043E\u0445\u043B\u043E\u0432\u0430 \u041D\u0438\u043D\u0430, \u0417\u0435\u0437\u044E\u043B\u0438\u043D \u0412\u0430\u0441\u0438\u043B\u0438\u0439.",
