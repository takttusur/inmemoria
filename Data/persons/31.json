3E\u044E\u0449\u0438\u043C \u0442\u0430\u043A\u0438\u0435 \u043D\u0435\u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043C\u044B\u0435 \u0026laquo;\u043D\u0430\u0448\u0438\u0026raquo; \u043F\u0435\u0441\u043D\u0438. \u042D\u0442\u043E \u043F\u043E\u0442\u043E\u043C, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0437\u0436\u0435, \u044F \u0443\u0437\u043D\u0430\u043B\u0430 \u0430\u0432\u0442\u043E\u0440\u043E\u0432 \u044D\u0442\u0438\u0445 \u043F\u0435\u0441\u0435\u043D. \u0410 \u0442\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0441\u043E\u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0441 \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u043B. \u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0441 \u0412\u043E\u043B\u043E\u0434\u0435\u0439 \u0438 \u0412\u0430\u0441\u0435\u0439.\u003C/p\u003E","Position":15,"CreateTime":"2012-09-14T15:18:33","Comment":"\u0412\u0430\u043C\u0431\u043E\u043B\u044C\u0434\u0442 (\u0424\u0438\u0441\u0435\u043D\u043A\u043E) \u041B\u044E\u0431\u043E\u0432\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u043E\u0432\u043D\u0430","Active":1},{"Id":841,"PersonId":31,"Name":"\u0411\u0430\u0431\u0443\u0440\u0447\u0435\u043D\u043A\u043E\u0432 \u0421.","ResourceType":"html","Rubric":"memoir","Data":"\u003Cp\u003E\u0421\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0439. \u041C\u0430\u0442\u0447\u0438\u043D\u0441\u043A\u0438\u0439 \u0443\u0437\u0435\u043B. \u0420\u0430\u0437\u043C\u044B\u0448\u043B\u0438\u0437\u043C\u044B \u0026nbsp;\u003Ca title=\u0022\u0421\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0439. \u041C\u0430\u0442\u0447\u0438\u043D\u0441\u043A\u0438\u0439 \u0443\u0437\u0435\u043B. 1987\u0433. \u0420\u0430\u0437\u043C\u044B\u0448\u043B\u0438\u0437\u043C\u044B\u0022 href=\u0022http://mountain.ru/article/article_display1.php?article_id=6909\u0022\u003Ehttp://mountain.ru/article/article_display1.php?art