44F \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0445 \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0441\u0442\u043E\u0432, \u0430 \u043F\u0440\u043E\u0441\u0442\u044B\u043C \u043F\u0430\u0440\u043D\u0435\u043C \u0441 \u0433\u0438\u0442\u0430\u0440\u043E\u0439, \u043A\u0430\u043A\u0438\u043C \u044F \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0432 \u043E\u0431\u0449\u0430\u0433\u0435 \u043D\u043E\u043C\u0435\u0440 6 \u043D\u0430 \u0026laquo;\u042E\u0436\u043A\u0435\u0026raquo;, \u043A\u0443\u0434\u0430 \u043E\u043D \u0437\u0430\u0431\u0440\u0451\u043B \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C \u0412\u0430\u0441\u0435\u0439 \u041B\u0443\u043A\u0438\u043D\u044B\u043C. \u042F, \u0442\u0443\u0440\u0438\u0441\u0442-\u043F\u0435\u0440\u0432\u043E\u0433\u043E\u0434\u043E\u043A, \u0431\u044B\u043B\u0430 \u043D\u0430\u043F\u043E\u0432\u0430\u043B \u0441\u0440\u0430\u0436\u0435\u043D\u0430 \u0438 \u0435\u0433\u043E \u043E\u0431\u043B\u0438\u043A\u043E\u043C \u0442\u0430\u043A\u043E\u0433\u043E \u0431\u044B\u0432\u0430\u043B\u043E \u0430\u043B\u044C\u043F\u0438\u043D\u0438\u0441\u0442\u0430 (\u043E\u043D \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u0442\u043E\u0433\u0434\u0430 \u0432\u0438\u0434\u0435\u043B\u0441\u044F \u0447\u0443\u0442\u044C \u043B\u0438 \u043D\u0435 \u043F\u043E\u043A\u043E\u0440\u0438\u0442\u0435\u043B\u0435\u043C \u042D\u0432\u0435\u0440\u0435\u0441\u0442\u0430), \u0438 \u0435\u0433\u043E \u0431\u0430\u0440\u0445\u0430\u0442\u0438\u0441\u0442\u044B\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C, \u043F\u043E\u044E\u0449\u0438\u043C \u0442\u0430\u043A\u0438\u0435 \u043D\u0435\u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043C\u044B\u0435 \u0026laquo;\u043D\u0430\u0448\u0438\u0026raquo; \u043F\u0435\u0441\u043D\u0438. \u042D\u0442\u043E \u043F\u043E\u0442\u043E\u043C, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0437\u0436\u0435, \u044F \u0443\u0437\u043D\u0430\u043B\u0430 \u0430\u0432\u0442\u043E\u0440\u043E\u0432 \u044D\u0442\u0438\u0445 \u043F\u0435\u0441\u0435\u043D. \u0410 \u0442\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0441\u043E\u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0441 \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u043B. \u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0441 \u0412\u043E\u043B\u043E\u0434\u0435\u0439 \u0438 \u0412\u0430\u0441\u0435\u0439.\u003C/p\u003E","Category":1,"AttachmentType":5,"Order":15,"CreatedAt":"2012-09-14T15:18:33","PersonId":0,"Person":null,"Id":0},{"Title":"\u0411\u0430\u0431\u0443\u0440\u0447\u0435\u043D\u043A\u043E\u0432 \u0421.","Subtitle":"\u0411\u0430\u0431\u0443\u0440\u0447\u0435\u043D\u043A\u043E\u0432 \u0421.","IsActive":true,"Data":"\u003Cp\u003E\u0421\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0439. \u041C\u0430\u0442\u0447\u0438\u043D\u0441\u043A\u0438\u0439 \u0443\u0437\u0435\u043B. \u0420\u0430\u0437\u043C\u044B\u0448\u043B\u0438\u0437\u043C\u044B \u0026nbsp;\u003Ca title=\u0022\u0421\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0439. \u041C\u0430\u0442\u0447\u0438\u043D\u0441\u043A\u0438\u0439 \u0443\u0437\u0435\u043B. 1987\u0433. \u0420\u0430\u0437\u043C\u044B\u0448\u043B\u0438\u0437\u043C\u044B\u0022 href=\u0022http://mountain.ru/article/article_display1.php?article_id=6909\u0022\u003Ehttp://mountain.ru/article/article_display1.php?article_id=6909\u003C/a\u003E\u003C/p\u003E","Category":1,"AttachmentType":5,"Order":16,"CreatedAt":"2014-10-18T16:31:57","PersonId":0,"Person":null,"Id":0}],"Id":31}